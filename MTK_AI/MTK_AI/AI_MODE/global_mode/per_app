#!/system/bin/sh

# ==========================================
# ==========================================
# KILL PREVIOUS RUNNING INSTANCES (ROBUST)
# ==========================================
# PID files fail due to race conditions and stale PIDs. 
# Instead, we directly check running processes for this exact script path.
SCRIPT_PATH="/data/adb/modules/MTK_AI/MTK_AI/AI_MODE/global_mode/per_app"

for pid in $(pgrep -f "$SCRIPT_PATH"); do
    # Kill all instances except the current running script ($$)
    if [ "$pid" != "$$" ]; then
        kill -9 "$pid" 2>/dev/null
    fi
done
# ==========================================
. /data/adb/modules/MTK_AI/MTK_AI/AI_MODE/auto_frequency/auto_frequency
MOD_DIR="/data/adb/modules/MTK_AI"
EXTERNAL_CFG="/sdcard/MTK_AI_Engine"
TRIMMING_PATH="$MOD_DIR/MTK_AI/AI_MODE/global_mode/trim_memory"
MODULE_EXECUTER="$MOD_DIR/MTK_AI/AI_MODE/global_mode/module_executer"
BYPASS_ON="$MOD_DIR/MTK_AI/AI_MODE/gaming_mode/bypass_on"
BYPASS_OFF="$MOD_DIR/MTK_AI/AI_MODE/normal_mode/bypass_off"
LOGIC_CPU7_PATH="$MOD_DIR/MTK_AI/AI_MODE/auto_frequency/cpu7"
LOGIC_CPU6_PATH="$MOD_DIR/MTK_AI/AI_MODE/auto_frequency/cpu6"
AI_MODE="$MOD_DIR/script_runner/monitor_app_stats"

DUMP=$(dumpsys activity activities 2>/dev/null)
CURRENT_TOP_APP=$(echo "$DUMP" | grep -m1 -E 'mResumedActivity|mFocusedApp' | grep -oE '[a-zA-Z0-9_]+(\.[a-zA-Z0-9_]+)+' | head -n 1)

unhibernation() {
cmd deviceidle whitelist +"${CURRENT_TOP_APP}"
cmd appops set "${CURRENT_TOP_APP}" DATA_SAVER allow >/dev/null 2>&1 || true
cmd app_hibernation set-state --user 0 --global "${CURRENT_TOP_APP}" false >/dev/null 2>&1 || true
cmd appops set "${CURRENT_TOP_APP}" RUN_IN_BACKGROUND allow 2>/dev/null
cmd appops set "${CURRENT_TOP_APP}" RUN_ANY_IN_BACKGROUND allow 2>/dev/null
cmd appops set "${CURRENT_TOP_APP}" WAKE_LOCK allow 2>/dev/null
am set-standby-bucket "${CURRENT_TOP_APP}" active 2>/dev/null

# ==========================================
# NEW: Additional boosting commands from `cmd activity`
# ==========================================
# Set background restriction level to unrestricted (highest priority/least restricted)
cmd activity set-bg-restriction-level "${CURRENT_TOP_APP}" unrestricted >/dev/null 2>&1

# Ensure the app is explicitly marked as active (not inactive)
cmd activity set-inactive "${CURRENT_TOP_APP}" false >/dev/null 2>&1
}
unhibernation

apply_renderer() {
    [ -z "$CURRENT_TOP_APP" ] && return 1
    local r=$(cat "/sdcard/MTK_AI_Engine/threading_configs/$CURRENT_TOP_APP.renderer" 2>/dev/null | tr -d '[:space:]')
    local c=$(getprop debug.hwui.renderer)
    
    case "$r" in
        skiavk|skiagl) [ "$c" != "$r" ] && setprop debug.hwui.renderer "$r" ;;
        *) [ -n "$c" ] && setprop debug.hwui.renderer "" ;;
    esac
}
apply_renderer

# ==========================================
# GPU FREQUENCY (OPP INDEX)
# ==========================================
apply_gpu_settings() {
    local app="$CURRENT_TOP_APP" idx gov base
    
    [ -z "$app" ] && return 1
    
    # ==========================================
    # 1. GPU OPP (Frequency)
    # ==========================================
    # Read per-app, fallback to global if empty/missing
    idx=$(cat "/sdcard/MTK_AI_Engine/per_app/${app}.gpu_opp" 2>/dev/null | tr -d '[:space:]')
    [ -z "$idx" ] && idx=$(cat "/sdcard/MTK_AI_Engine/global_gpu_opp_index.txt" 2>/dev/null | tr -d '[:space:]')
    
    # Apply to MTK GPU paths (supports -1 for unlock)
    [ -n "$idx" ] && {
        echo "$idx" > /proc/gpufreq/gpufreq_opp_freq 2>/dev/null
        echo "$idx" > /proc/gpufreqv2/fix_target_opp_index 2>/dev/null
    }

    # ==========================================
    # 2. GPU Governor
    # ==========================================
    # Read per-app, fallback to global
    gov=$(cat "/sdcard/MTK_AI_Engine/per_app/${app}.gpu_governor" 2>/dev/null | tr -d '[:space:]')
    [ -z "$gov" ] && gov=$(cat "/sdcard/MTK_AI_Engine/gpu_governor.txt" 2>/dev/null | tr -d '[:space:]')
    
    # Apply governor if a valid value is found
    if [ -n "$gov" ]; then
        # Auto-detect GPU devfreq path (mirrors the candidate bases from gpu.js)
        for base in \
            "/sys/devices/platform/13000000.mali/devfreq/13000000.mali" \
            "/sys/devices/platform/soc/13000000.mali/devfreq/13000000.mali" \
            "/sys/class/devfreq/13000000.mali" \
            "/sys/devices/platform/26000000.mali/devfreq/26000000.mali" \
            "/sys/devices/platform/gpu/devfreq/gpu"; do
            
            if [ -f "${base}/governor" ]; then
                echo "$gov" > "${base}/governor" 2>/dev/null
                break
            fi
        done
    fi
}
apply_gpu_settings

# ==========================================
# DEVFREQ GOVERNOR & FREQUENCIES
# ==========================================
apply_devfreq() {
    PERAPP_DIR="$EXTERNAL_CFG/per_app"
    GLOBAL_CFG_FILE="$EXTERNAL_CFG/devfreq_config.json"

    TARGET_GOV=""
    TARGET_MIN_FREQ=""
    TARGET_MAX_FREQ=""

    # 1. Read per-app raw text files first
    if [ -n "$CURRENT_TOP_APP" ]; then
        DEVFREQ_GOV_FILE="${PERAPP_DIR}/${CURRENT_TOP_APP}.devfreq_governor"
        DEVFREQ_MIN_FILE="${PERAPP_DIR}/${CURRENT_TOP_APP}.devfreq_min_freq"
        DEVFREQ_MAX_FILE="${PERAPP_DIR}/${CURRENT_TOP_APP}.devfreq_max_freq"

        TARGET_GOV=$(cat "$DEVFREQ_GOV_FILE" 2>/dev/null | tr -d '\r\n')
        TARGET_MIN_FREQ=$(cat "$DEVFREQ_MIN_FILE" 2>/dev/null | tr -d '\r\n')
        TARGET_MAX_FREQ=$(cat "$DEVFREQ_MAX_FILE" 2>/dev/null | tr -d '\r\n')
    fi

    # 2. Fallback to global JSON config if per-app values are missing
    if [ -f "$GLOBAL_CFG_FILE" ]; then
        if command -v jq >/dev/null 2>&1; then
            # Parse via jq
            [ -z "$TARGET_GOV" ] && TARGET_GOV=$(jq -r '.governor // empty' "$GLOBAL_CFG_FILE" 2>/dev/null)

            IS_LOCKED=$(jq -r '.isLocked // false' "$GLOBAL_CFG_FILE" 2>/dev/null)
            if [ "$IS_LOCKED" = "true" ]; then
                MIN_MHZ=$(jq -r '.minFreq // empty' "$GLOBAL_CFG_FILE" 2>/dev/null)
                MAX_MHZ=$(jq -r '.maxFreq // empty' "$GLOBAL_CFG_FILE" 2>/dev/null)

                [ -z "$TARGET_MIN_FREQ" ] && [ -n "$MIN_MHZ" ] && [ "$MIN_MHZ" != "null" ] && TARGET_MIN_FREQ=$((MIN_MHZ * 1000))
                [ -z "$TARGET_MAX_FREQ" ] && [ -n "$MAX_MHZ" ] && [ "$MAX_MHZ" != "null" ] && TARGET_MAX_FREQ=$((MAX_MHZ * 1000))
            fi
        else
            # Fallback parsing via grep/sed
            [ -z "$TARGET_GOV" ] && TARGET_GOV=$(grep -o '"governor": *"[^"]*"' "$GLOBAL_CFG_FILE" | sed 's/.*: *"\([^"]*\)"/\1/')

            IS_LOCKED=$(grep -o '"isLocked": *[^,}]*' "$GLOBAL_CFG_FILE" | sed 's/.*: *\([^,}]*\)/\1/' | tr -d ' ')
            if [ "$IS_LOCKED" = "true" ]; then
                MIN_MHZ=$(grep -o '"minFreq": *[0-9]*' "$GLOBAL_CFG_FILE" | sed 's/.*: *\([0-9]*\)/\1/')
                MAX_MHZ=$(grep -o '"maxFreq": *[0-9]*' "$GLOBAL_CFG_FILE" | sed 's/.*: *\([0-9]*\)/\1/')

                [ -z "$TARGET_MIN_FREQ" ] && [ -n "$MIN_MHZ" ] && TARGET_MIN_FREQ=$((MIN_MHZ * 1000))
                [ -z "$TARGET_MAX_FREQ" ] && [ -n "$MAX_MHZ" ] && TARGET_MAX_FREQ=$((MAX_MHZ * 1000))
            fi
        fi
    fi

    # 3. Default Governor fallback
    TARGET_GOV=${TARGET_GOV:-"simple_ondemand"}

    # 4. Apply settings across target devfreq sysfs nodes
    for dev in /sys/class/devfreq/*; do
        [ -d "$dev" ] || continue
        name=$(basename "$dev")
        
        # Target memory controllers, DVFS, DMC, GPU, and GPU bandwidth
        if [[ "$name" == *"mem"* ]] || [[ "$name" == *"dvfs"* ]] || [[ "$name" == *"dmc"* ]] || [[ "$name" == *"gpu"* ]] || [[ "$name" == *"gpubw"* ]]; then
            
            # Apply Governor
            if [ -f "$dev/governor" ]; then
                echo "$TARGET_GOV" > "$dev/governor" 2>/dev/null
            fi

            # Apply Min Frequency
            if [ -n "$TARGET_MIN_FREQ" ] && [ -f "$dev/min_freq" ]; then
                echo "$TARGET_MIN_FREQ" > "$dev/min_freq" 2>/dev/null
            fi

            # Apply Max Frequency
            if [ -n "$TARGET_MAX_FREQ" ] && [ -f "$dev/max_freq" ]; then
                echo "$TARGET_MAX_FREQ" > "$dev/max_freq" 2>/dev/null
            fi

        fi
    done
}
apply_devfreq

refresh_rate() {
    # --- Execute per-app refresh rate ---
    REFRESH_FILE="/sdcard/MTK_AI_Engine/manual_refresh_lock.txt"
    MODE_FILE="/sdcard/MTK_AI_Engine/refresh_locks/${CURRENT_TOP_APP}.mode"

    # 1. Read the global mode ID (strip spaces, tabs, newlines)
    MODE_ID=""
    if [ -f "$REFRESH_FILE" ]; then
        MODE_ID=$(cat "$REFRESH_FILE" 2>/dev/null | tr -d '[:space:]')
    fi

    # 2. Determine which mode to apply (Per-app vs Global)
    TARGET_MODE=""
    if [ -f "$MODE_FILE" ]; then
        # Read the per-app mode ID
        MODE=$(cat "$MODE_FILE" 2>/dev/null | tr -d '[:space:]')
        
        if [ -n "$MODE" ]; then
            TARGET_MODE="$MODE"      # Use per-app mode if valid
        else
            TARGET_MODE="$MODE_ID"   # Fallback to global if per-app file is empty
        fi
    else
        TARGET_MODE="$MODE_ID"       # Fallback to global if per-app file doesn't exist
    fi

    # 3. Last fallback if no other files found for mode (or if they were empty)
    if [ -z "$TARGET_MODE" ]; then
        TARGET_MODE="-1"
    fi

    # 4. Execute the refresh rate change
    # (Note: TARGET_MODE will always have a value now, but the check is kept for safety)
    if [ -n "$TARGET_MODE" ]; then
        service call SurfaceFlinger 1035 i32 "$TARGET_MODE"
    fi
    # -----------------------------------------
}
refresh_rate

shell_cmd() {
    # Define the path for the specific app's base64 command file
    CMD_FILE="/sdcard/MTK_AI_Engine/per_app/${CURRENT_TOP_APP}.cmd"

    # Check if the file exists
    if [ -f "$CMD_FILE" ]; then
        # Read the base64 content and strip any whitespace/newlines
        B64_CMD=$(cat "$CMD_FILE" 2>/dev/null | tr -d '[:space:]')

        if [ -n "$B64_CMD" ]; then
            # Decode the base64 string
            DECODED_CMD=$(echo "$B64_CMD" | base64 -d 2>/dev/null)

            # Execute the decoded shell command if it's not empty
            if [ -n "$DECODED_CMD" ]; then
                eval "$DECODED_CMD"
            fi
        fi
    fi
}
shell_cmd

boost_process_aggressive() {
    local target_app="$CURRENT_TOP_APP"
    [ -z "$target_app" ] && return 1

    # 1. Identify main process and ALL child threads/sub-processes
    local pids
    pids=$(pidof "$target_app" 2>/dev/null)

    # 2. Apply maximum real-time boost across ALL threads of the target process
    for pid in $pids; do
        # Target all lightweight processes (threads) under this PID
        for tid in $(ls "/proc/$pid/task" 2>/dev/null); do
            # Maximum Nice value
            renice -n -20 -p "$tid" >/dev/null 2>&1
            
            # Switch to Real-Time FIFO scheduling policy (Priority 99 - Absolute Maximum)
            chrt -f -p 99 "$tid" >/dev/null 2>&1
            
            # CPU Affinity: Force strictly onto big/prime cores (e.g., 0xF0 for cores 4-7)
            taskset -p 0xF0 "$tid" >/dev/null 2>&1
            
            # IO Priority: Real-time class, level 0 (highest precedence)
            ionice -c 1 -n 0 -p "$tid" >/dev/null 2>&1
        done

        # 3. Make target completely immune to OOM Killer
        echo -1000 > "/proc/$pid/oom_score_adj" 2>/dev/null
    done

    # 4. Apply LOWEST priority to all PIDs currently in the background cpuset
    if [ -f "/dev/cpuset/background/cgroup.procs" ]; then
        local bg_pids
        bg_pids=$(cat "/dev/cpuset/background/cgroup.procs" 2>/dev/null)
        
        for pid in $bg_pids; do
            # Skip if this PID accidentally belongs to our boosted target app
            echo "$pids" | grep -qw "$pid" && continue

            for tid in $(ls "/proc/$pid/task" 2>/dev/null); do
                # Lowest Nice value
                renice -n 19 -p "$tid" >/dev/null 2>&1
                
                # Switch to IDLE scheduling policy (Absolute lowest CPU priority)
                chrt -i -p 0 "$tid" >/dev/null 2>&1
                
                # CPU Affinity: Force strictly onto little cores (e.g., 0x0F for cores 0-3)
                # Adjust 0x0F if your device has a different little-core layout (e.g., 0x3F for 6 little cores)
                taskset -p 0x0F "$tid" >/dev/null 2>&1
                
                # IO Priority: Idle class (lowest precedence)
                ionice -c 3 -p "$tid" >/dev/null 2>&1
            done
            
            # Make background processes highly susceptible to OOM Killer (first to be killed)
            echo 1000 > "/proc/$pid/oom_score_adj" 2>/dev/null
        done
    fi
}
[ -f /sdcard/MTK_AI_Engine/app_priority ] && boost_process_aggressive
game_api
# CPU GOVERNOR & FREQUENCY LIMIT
apply_cpu_settings() {
    local target_app="$CURRENT_TOP_APP"
    [ -z "$target_app" ] && return 1
    
    local PERAPP_DIR="/sdcard/MTK_AI_Engine/per_app"
    
    # Define fallback files
    local FALLBACK_GOV="/sdcard/MTK_AI_Engine/manual_governor.txt"
    local FALLBACK_FREQ="/sdcard/MTK_AI_Engine/manual_touch_active_freq.txt"
    
    # 1. Apply CPU Governor
    local gov_file="${PERAPP_DIR}/${target_app}.governor"
    # Fallback if per-app config is missing
    [ ! -f "$gov_file" ] && gov_file="$FALLBACK_GOV"
    
    if [ -f "$gov_file" ]; then
        local gov=$(cat "$gov_file" 2>/dev/null | tr -d '[:space:]')
        if [ -n "$gov" ] && [ "$gov" != "default" ]; then
            for cpu in /sys/devices/system/cpu/cpu[0-9]*; do
                chmod 777 "$cpu/cpufreq/scaling_governor" 2>/dev/null
                echo "$gov" > "$cpu/cpufreq/scaling_governor" 2>/dev/null
            done
        fi
    fi
    
    # 2. Apply CPU Frequency Limit (Percentage)
    local cpu_limit_file="${PERAPP_DIR}/${target_app}.cpu_percent"
    local limit_pct=""
    
    # Check per-app config, then fallback file, then default to 100%
    if [ -f "$cpu_limit_file" ]; then
        limit_pct=$(cat "$cpu_limit_file" 2>/dev/null | tr -d '[:space:]')
    elif [ -f "$FALLBACK_FREQ" ]; then
        limit_pct=$(cat "$FALLBACK_FREQ" 2>/dev/null | tr -d '[:space:]')
    else
        # Fallback to maximum 100% frequency if no manual touch active file found
        limit_pct=100
    fi
    
    if [ -n "$limit_pct" ] && [ "$limit_pct" -gt 0 ] 2>/dev/null; then
        for cpu in /sys/devices/system/cpu/cpu[0-9]*; do
            local abs_max=$(cat "$cpu/cpufreq/cpuinfo_max_freq" 2>/dev/null)
            if [ -n "$abs_max" ]; then
                # Note: This assumes the fallback file also contains a percentage (0-100). 
                # If the fallback file contains an absolute frequency (e.g., 2000000), 
                # you may need to adjust the math below.
                local new_max=$((abs_max * limit_pct / 100))
                chmod 777 "$cpu/cpufreq/scaling_max_freq" 2>/dev/null
                echo "$new_max" > "$cpu/cpufreq/scaling_max_freq" 2>/dev/null
                chmod 000 "$cpu/cpufreq/scaling_max_freq" 2>/dev/null
            fi
        done
    fi
}
apply_cpu_settings

nohup sh "/data/adb/modules/MTK_AI/MTK_AI/AI_MODE/global_mode/ram_cleaner" >/dev/null 2>&1 &

run_cmd() {
    if [ -f "$EXTERNAL_CFG/enable_trim" ]; then
        pgrep -f "trim_memory" > /dev/null || nohup sh "$TRIMMING_PATH" 2>&1 &
    else
        pkill -f "trim_memory" 2>/dev/null
    fi

    if [ -f "$EXTERNAL_CFG/enable_bypass" ] && [ -f "/dev/.mtk_ai_active_game" ]; then
        pgrep -f "bypass_on" > /dev/null || nohup sh "$BYPASS_ON" 2>&1 &
    else
        pgrep -f "bypass_off" > /dev/null || nohup sh "$BYPASS_OFF" 2>&1 &
    fi

    if [ -f "$EXTERNAL_CFG/random_device" ]; then
        nohup sh "/data/adb/modules/MTK_AI/script_runner/sf_controller" 2>&1 &
    fi

    if [ -f "$EXTERNAL_CFG/enable_cpu" ]; then
        pgrep -f "cpu6" > /dev/null || nohup sh "$LOGIC_CPU6_PATH" 2>&1 &
        pgrep -f "cpu7" > /dev/null || nohup sh "$LOGIC_CPU7_PATH" 2>&1 &
    else
        pkill -f "cpu6" 2>/dev/null
        pkill -f "cpu7" 2>/dev/null
    fi

    if [ -f "$EXTERNAL_CFG/enable_module" ]; then
        pgrep -f "module_executer" 2>/dev/null | grep -vw "$$" | while read -r pid; do
            kill -9 "$pid" 2>/dev/null
        done
        sleep 0.2
        export PATH="/system/bin:/system/xbin:/sbin:/vendor/bin"
        cd "$MOD_DIR" || exit 1
        nohup sh "$MODULE_EXECUTER" >/dev/null 2>&1 &
    else
        pkill -f "module_executer" 2>/dev/null
    fi
}

find_touchscreen() {
    for dev in /dev/input/event*; do
        if getevent -p "$dev" 2>/dev/null | grep -q "0035"; then
            echo "$dev"
            return 0
        fi
    done
}

TIMEOUT=5
F="/sdcard/MTK_AI_Engine/touch_timeout.txt"

[ -f "$F" ] && T=$(tr -d ' \r\n' < "$F") && [ "$T" -eq "$T" ] 2>/dev/null && TIMEOUT=$T

# Initial State
LAST_ACTIVITY=$(date +%s)
STATE="PERF"

# 🔧 FIX #3: resolve touchscreen device ONCE before the loop
TS_DEV=$(find_touchscreen)
if [ -z "$TS_DEV" ]; then
    log_msg "WARNING: No touchscreen device found — idle detection disabled"
fi

while true; do
    if [ -n "$TS_DEV" ] && timeout 1s getevent -c 1 "$TS_DEV" > /dev/null 2>&1; then
        LAST_ACTIVITY=$(date +%s)
        if [ "$STATE" = "SAVE" ]; then
            STATE="PERF"
            touch_active
            apply_cpu_settings
            run_cmd
        fi
    else
        NOW=$(date +%s)
        ELAPSED=$((NOW - LAST_ACTIVITY))

        if [ "$ELAPSED" -ge "$TIMEOUT" ] && [ "$STATE" = "PERF" ]; then
            STATE="SAVE"
            touch_inactive
            run_cmd
        fi
    fi

    CUR_TIME=$(date +%s)
    DIFF=$((CUR_TIME - LAST_ACTIVITY))
    printf "\r[Mode: %s] [Idle: %ds]    " "$STATE" "$DIFF"
    sleep 1
done

