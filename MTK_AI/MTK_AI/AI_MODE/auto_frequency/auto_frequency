#!/system/bin/sh

# LITE MODE

MOD_DIR="/data/adb/modules/MTK_AI"
BB="$MOD_DIR/busybox"
EXTERNAL_CFG="/sdcard/MTK_AI_Engine"
NOTIFY_ENABLED_FILE="$EXTERNAL_CFG/enable_notifications"
TOUCH_ACTIVE="$EXTERNAL_CFG/enable_limiter"

press_check() {
  timeout "${1}" getevent -lqn | grep -qE "KEY_POWER.*KEY_POWER|KEY_POWER.*KEY_POWER"
}

ultimate_rescue() {
  local log_file="/data/local/tmp/rescue_$(date +%Y%m%d_%H%M%S).log"
  {
    echo "=== Ultimate Rescue Script Started at $(date) ==="
    echo "[*] Disabling all modules..."
    local list=""
    for mod in /data/adb/modules/*; do
      if [[ -d "${mod}" && ! -f "${mod}/disable" ]]; then
        list="${list} ${mod}/disable"
      fi
    done
    [[ -n "${list}" ]] && touch ${list}
    echo "[*] Clearing pending module updates..."
    rm -rf /data/adb/modules_update/* 2>/dev/null
    rm -rf /data/adb/ksu/modules_update/* 2>/dev/null 
    rm -rf /data/adb/ap/modules_update/* 2>/dev/null   
    echo "[*] Wiping all system, dalvik, and runtime caches..."
    rm -rf /data/dalvik-cache/* /data/vendor/dalvik-cache/* /data/system/dalvik-cache/* 2>/dev/null
    rm -rf /data/misc/profiles/* 2>/dev/null
    rm -rf /data/system/package_cache/* /data/system/users/*/package_cache/* 2>/dev/null
    rm -rf /data/cache/* /cache/* 2>/dev/null
    rm -rf /data/property/* 2>/dev/null
    echo "[*] Clearing Theme, Font, and UI caches..."
    rm -rf /data/system/theme/* /data/misc/theme/* 2>/dev/null      
    rm -rf /data/fonts/* /data/misc/fonts/* 2>/dev/null         
    rm -rf /data/system/inputmethod/* 2>/dev/null            
    echo "[*] Clearing Audio and Display caches..."
    rm -rf /data/misc/audioserver/* 2>/dev/null
    rm -rf /data/misc/display/* 2>/dev/null
    echo "[*] Fixing /data/adb and module overlay permissions..."
    chmod -R 755 /data/adb/ 2>/dev/null
    find /data/adb/modules -type d -name "system" -exec chmod -R 755 {} + 2>/dev/null
    find /data/adb/modules -type d -name "vendor" -exec chmod -R 755 {} + 2>/dev/null
    echo "[*] Backing up and disabling custom boot scripts..."
    for script_dir in post-fs-data.d service.d; do
      if [[ -d "/data/adb/${script_dir}" ]]; then
        mkdir -p "/data/adb/${script_dir}.bak"
        mv /data/adb/${script_dir}/* "/data/adb/${script_dir}.bak/" 2>/dev/null
      fi
    done
    echo "[*] Restoring SELinux contexts..."
    if command -v restorecon >/dev/null 2>&1; then
      restorecon -RF /data/adb/ 2>/dev/null
    fi
    echo "[*] Checking for corrupted root manager databases..."
    if [[ -f /data/adb/magisk/magisk.db ]] && command -v sqlite3 >/dev/null 2>&1; then
      sqlite3 /data/adb/magisk/magisk.db "VACUUM;" 2>/dev/null
      if [[ $? -ne 0 ]]; then
        echo "[!] Magisk DB corrupted. Renaming to force recreation..."
        mv /data/adb/magisk/magisk.db /data/adb/magisk/magisk.db.corrupt 2>/dev/null
      fi
    fi
    echo "=== Rescue Actions Complete. Rebooting in 3 seconds... ==="
    sleep 3
    reboot
  } | tee "$log_file" 2>&1
}

_apply_freq() {
    _val=$3; _file=$2; _min=$4; _max=$5
    [ -f "$_file" ] && _val=$(tr -d '\r\n ' < "$_file")
    [ "$_val" -lt "$_min" ] 2>/dev/null && _val=$_min
    [ "$_val" -gt "$_max" ] 2>/dev/null && _val=$_max
    
    for i in 4 5 6 7; do
        _c="/sys/devices/system/cpu/cpu$i/cpufreq"
        [ -f "$_c/cpuinfo_max_freq" ] || continue
        
        _t=$(( $(cat "$_c/cpuinfo_max_freq") * _val / 100 ))
        chmod 777 "$_c/scaling_max_freq" 2>/dev/null
        echo $_t > "$_c/scaling_max_freq"
        chmod 444 "$_c/scaling_max_freq" 2>/dev/null
    done
    sync
}

touch_active() {
    ps 2>/dev/null | grep -v grep | grep -qw mtk_ai_engine && return 0
    [ -f "/dev/.mtk_ai_active_game" ] && return 0
    [ -f "/sdcard/MTK_AI_Engine/per_app/${CURRENT_TOP_APP}.cpu_percent" ] && return 0
    
    _apply_freq 100 "/sdcard/MTK_AI_Engine/manual_touch_active_freq.txt" 100 50 100
}

touch_inactive() {
    [ ! -f "$TOUCH_ACTIVE" ] && return 0
    ps 2>/dev/null | grep -v grep | grep -qw mtk_ai_engine && return 0
    [ -f "/dev/.mtk_ai_active_game" ] && return 0
    [ -f "/sdcard/MTK_AI_Engine/per_app/${CURRENT_TOP_APP}.cpu_percent" ] && return 0
    
    _apply_freq 30 "/sdcard/MTK_AI_Engine/manual_inactive_freq.txt" 30 25 50
}

off_screen_profile() {
BB="/data/adb/modules/MTK_AI/busybox"
DIR="/sdcard/MTK_AI_Engine"
[ "$($BB cat $DIR/offscreen_enabled.txt 2>/dev/null | $BB tr -d '[:space:]')" != "1" ] && exit 0
GOV=$($BB cat $DIR/manual_offscreen_gov.txt 2>/dev/null | $BB tr -d '[:space:]')
PCT=$($BB cat $DIR/manual_offscreen_freq.txt 2>/dev/null | $BB tr -d '[:space:]')
GOV=${GOV:-powersave}
PCT=${PCT:-50}
for f in /sys/devices/system/cpu/cpufreq/policy*/scaling_governor /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
    [ -f "$f" ] && chmod 777 "$f" && echo "$GOV" > "$f"
done
MAX=$($BB cat /sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq | $BB tr -d '[:space:]')
FREQ=$((MAX * PCT / 100))
for f in /sys/devices/system/cpu/cpufreq/policy*/scaling_max_freq /sys/devices/system/cpu/cpu*/cpufreq/scaling_max_freq; do
    [ -f "$f" ] && chmod 777 "$f" && echo "$FREQ" > "$f"
done
}

resolution() {
# Resolution
C="/sdcard/MTK_AI_Engine"
D=$(grep -m1 "^density=" "$C/resolution_scale_config.txt" 2>/dev/null | cut -d= -f2 | tr -d '\r\n\t ')
[ "$D" -gt 0 ] 2>/dev/null && su -c "wm density $D" >/dev/null 2>&1 && log "Density: $D"
}

force_kill() {
CONFIG_DIR="/sdcard/MTK_AI_Engine/config"
FORCE_KILL_FILE="${CONFIG_DIR}/force_kill.list"
NEVER_KILL_FILE="${CONFIG_DIR}/never_kill.list"

# Critical apps that must NEVER be killed (from hibernator.js)
CRITICAL_APPS="
com.android.systemui
com.android.bluetooth
com.android.phone
com.android.stk
com.google.android.gms
com.google.android.gsf
com.google.android.packageinstaller
com.android.settings
com.google.android.setupwizard
com.android.launcher3
com.google.android.inputmethod.latin
android
com.android.providers.settings
com.android.providers.downloads
com.android.providers.media.module
com.android.externalstorage
com.android.documentsui
com.android.permissioncontroller
com.android.vending
com.google.android.webview
"

# Critical prefixes (apps starting with these are protected)
CRITICAL_PREFIXES="android.hardware. android.system. vendor. com.android.system"

mkdir -p "$CONFIG_DIR"

is_critical() {
    local pkg="$1"
    # Check exact match
    for critical in $CRITICAL_APPS; do
        [ "$pkg" = "$critical" ] && return 0
    done
    # Check prefix match
    for prefix in $CRITICAL_PREFIXES; do
        case "$pkg" in
            ${prefix}*) return 0 ;;
        esac
    done
    return 1
}

get_current_app() {
    # 🎯 Extract current top app package name
    local top_app=$(dumpsys activity activities 2>/dev/null | grep -m1 'mResumedActivity' | grep -oE '[a-zA-Z0-9_]+(\.[a-zA-Z0-9_]+)+' | head -n 1)
    
    if [ -z "$top_app" ]; then
        top_app=$(dumpsys activity activities 2>/dev/null | grep -m1 'mFocusedApp' | grep -oE '[a-zA-Z0-9_]+(\.[a-zA-Z0-9_]+)+' | head -n 1)
    fi
    
    if [ -z "$top_app" ]; then
        top_app=$(dumpsys window 2>/dev/null | grep -m1 'mCurrentFocus' | grep -oE '[a-zA-Z0-9_]+(\.[a-zA-Z0-9_]+)+' | head -n 1)
    fi
    
    # ✅ Validate package name format (allows uppercase)
    if echo "$top_app" | grep -qE '^[a-zA-Z][a-zA-Z0-9_]*(\.[a-zA-Z0-9_]+)+$'; then
        echo "$top_app"
    fi
}

echo "📦 Fetching installed packages..."
ALL_PACKAGES=$(pm list packages 2>/dev/null | cut -d: -f2 | sort -u)

if [ -z "$ALL_PACKAGES" ]; then
    echo "❌ Failed to get package list. Are you root?"
    exit 1
fi

TOTAL=$(echo "$ALL_PACKAGES" | wc -l)
echo "📊 Total installed packages: $TOTAL"

# Detect current top app
echo "🎯 Detecting current top app..."
CURRENT_APP=$(get_current_app)
if [ -n "$CURRENT_APP" ]; then
    echo "✅ Current top app: $CURRENT_APP"
else
    echo "⚠️ Could not detect current top app"
fi

is_in_never_kill() {
    [ -f "$NEVER_KILL_FILE" ] && grep -Fqx -- "$1" "$NEVER_KILL_FILE"
}

# 1. 🛡️ ADD current app to Never Kill list
if [ -n "$CURRENT_APP" ] && ! is_critical "$CURRENT_APP"; then
    if is_in_never_kill "$CURRENT_APP"; then
        echo "ℹ️ Current app already protected: $CURRENT_APP"
    else
        echo "$CURRENT_APP" >> "$NEVER_KILL_FILE"
        echo "🛡️ Added current app to Never Kill list: $CURRENT_APP"
    fi
fi

# Initialize lists for Force Kill
FORCE_LIST=""
ADDED_FORCE=0
SKIPPED=0

# 2. Add all non-critical apps to Force Kill list
for pkg in $ALL_PACKAGES; do
    pkg=$(echo "$pkg" | tr -d '[:space:]')
    [ -z "$pkg" ] && continue

    # Skip current app
    [ "$pkg" = "$CURRENT_APP" ] && continue

    # Skip packages already protected in Never Kill file
    if is_in_never_kill "$pkg"; then
        SKIPPED=$((SKIPPED + 1))
        continue
    fi

    if is_critical "$pkg"; then
        SKIPPED=$((SKIPPED + 1))
    else
        if [ -z "$FORCE_LIST" ]; then
            FORCE_LIST="$pkg"
        else
            FORCE_LIST="${FORCE_LIST}
${pkg}"
        fi
        ADDED_FORCE=$((ADDED_FORCE + 1))
    fi
done

# Write Force Kill file
if [ -n "$FORCE_LIST" ]; then
    printf '%s\n' "$FORCE_LIST" > "$FORCE_KILL_FILE"
else
    : > "$FORCE_KILL_FILE"
fi

echo "⚡ Added $ADDED_FORCE apps to Force Kill list"
echo "⏭️ Skipped $SKIPPED apps"

# ⚠️ Note: NEVER_KILL_FILE is intentionally NOT overwritten here to preserve your existing protections!

touch /sdcard/MTK_AI_Engine/enable_cleaner

echo "🛡️ Skipped $SKIPPED critical system apps"
echo "✅ Done! Configs saved to $CONFIG_DIR"
}

refresh_rate() {
    # --- Execute per-app refresh rate ---
    REFRESH_FILE="/sdcard/MTK_AI_Engine/manual_refresh_lock.txt"
    MODE_FILE="/sdcard/MTK_AI_Engine/refresh_locks/${CURRENT_TOP_APP}.mode"

    # 1. Read the global mode ID (strip spaces, tabs, newlines)
    MODE_ID=""
    if [ -f "$REFRESH_FILE" ]; then
        MODE_ID=$(cat "$REFRESH_FILE" 2>/dev/null | tr -d '[:space:]')
    fi

    # 2. Determine which mode to apply (Per-app vs Global)
    TARGET_MODE=""
    if [ -f "$MODE_FILE" ]; then
        # Read the per-app mode ID
        MODE=$(cat "$MODE_FILE" 2>/dev/null | tr -d '[:space:]')
        
        if [ -n "$MODE" ]; then
            TARGET_MODE="$MODE"      # Use per-app mode if valid
        else
            TARGET_MODE="$MODE_ID"   # Fallback to global if per-app file is empty
        fi
    else
        TARGET_MODE="$MODE_ID"       # Fallback to global if per-app file doesn't exist
    fi

    # 3. Execute the refresh rate change ONLY if we have a valid mode
    if [ -n "$TARGET_MODE" ]; then
        service call SurfaceFlinger 1035 i32 "$TARGET_MODE"
    fi
    # -----------------------------------------
}

exclude_killing() {
    # Get all PIDs under MTK_AI
    for pid in $(pgrep -f "/data/adb/modules/MTK_AI"); do
        cmdline=$(cat /proc/$pid/cmdline 2>/dev/null | tr '\0' ' ')
        
        # Exclude if cmdline contains action.sh, powersavex, or is inside the lib/lib64 folders
        # The trailing '/' ensures we match the folder path, not just a filename starting with 'lib'
        if ! echo "$cmdline" | grep -qE "action\.sh|update_checker\.sh|powersavex|/data/adb/modules/MTK_AI/lib(64)?/"; then
            kill -9 $pid 2>/dev/null
        fi
    done
}

game_api() {
local DIR="/sdcard/MTK_AI_Engine/per_app"
    [ -d "$DIR" ] || return
    local APPLIED=" "

    for f in "$DIR"/*; do
        [ -f "$f" ] || continue
        local p="${f##*/}"; p="${p%.*}"
        case "$APPLIED" in *" $p "*) continue;; esac
        APPLIED="$APPLIED$p "

        local ds=$(cat "$DIR/$p.downscale" 2>/dev/null | tr -d '[:space:]')
        ds=${ds:-100}; local ds_f=$(awk "BEGIN{printf \"%.1f\",$ds/100}")

        local fps=$(cat "$DIR/$p.fps" 2>/dev/null | tr -d '[:space:]')
        fps=${fps:-0}; local fps_str=""; [ "$fps" -gt 0 ] 2>/dev/null && fps_str="$fps"

        local angle=$(cat "$DIR/$p.use_angle" 2>/dev/null | tr -d '[:space:]')
        local angle_str="false"; [ "$angle" = "1" ] && angle_str="true"

        local boost=$(cat "$DIR/$p.loading_boost" 2>/dev/null | tr -d '[:space:]')
        boost=${boost:--1}
        
        cmd game reset "$p" 2>/dev/null

        device_config put game_overlay "$p" "mode=2,downscaleFactor=1.0,useAngle=false,loadingBoost=-1:mode=4,downscaleFactor=${ds_f},fps=${fps_str},useAngle=${angle_str},loadingBoost=${boost}"

        local gm=$(cat "$DIR/$p.gamemode" 2>/dev/null | tr -d '[:space:]')
        [ -n "$gm" ] && cmd game mode "$gm" "$p" 2>/dev/null
    done
}

trimmer() {
LIMIT_BYTES=51200 # 50 * 1024 bytes
# Check if directory exists
if [ ! -d "$EXTERNAL_CFG" ]; then
    echo "Error: Directory $TARGET_DIR does not exist."
    exit 1
fi

# Find files larger than 50KB and truncate them
find "$EXTERNAL_CFG" -type f -size +50k | while read -r file; do
    echo "Limiting: $file"
    # Extract the first 51200 bytes to a temp file, then replace the original
    head -c $LIMIT_BYTES "$file" > "${file}.tmp" && mv "${file}.tmp" "$file"
done
}
OUT="/data/adb/modules/MTK_AI/MTK_AI/AI_MODE/normal_mode/stock_tweaks.sh"
thermal() {
    # 1. Safely ensure the directory and file exist without modifying existing content
    mkdir -p "$(dirname "$OUT")"
    [ -f "$OUT" ] || touch "$OUT"

    # 2. Optimized pipeline: replaces multiple greps with a single awk command for better performance
    getprop | awk -F'[][]' '/init\.svc\..*thermal.*\[running\]/ {print $2}' | sed 's/^init\.svc\.//' | while read -r svc; do
        if [ -n "$svc" ]; then
            # 3. Duplicate check: only append if the exact command is NOT already in the file
            if ! grep -qxF "start $svc" "$OUT"; then
                echo "start $svc" >> "$OUT"
            fi
        fi
    done
}

hibernation() {
BRIGHTNESS_FILES=$(find /sys -name "brightness" -type f 2>/dev/null)
screen_on() { [ -n "$BRIGHTNESS_FILES" ] && grep -q -v '^0$' $BRIGHTNESS_FILES 2>/dev/null; }

# Exit immediately if screen is already on
screen_on && { echo "Screen on, skipping."; return 0; }
for f in "enabled true" "vibration_disabled true" "animation_disabled true" "launch_boost_disabled true" "aod_disabled true" "datasaver true" "force_all_apps_standby true" "quick_doze_enabled true" "soundtrigger_disabled true" "optional_sensors_disabled true" "gps_mode 3" "adjust_brightness_factor 0.5"; do device_config put battery_saver $f; done
NEVER_KILL_FILE="${CONFIG_DIR}/never_kill.list"
for app in $(cmd package list packages 2>/dev/null | cut -d: -f2); do
    # Break loop if screen turns on during execution
    screen_on && break

    # Skip empty, root apps, and protected apps
    case "$app" in ""|com.topjohnwu.magisk|*media*|*bluetooth*|*audio*|me.weishu.kernelsu) continue;; esac
    [ -f "$NEVER_KILL_FILE" ] && grep -Fqx "$app" "$NEVER_KILL_FILE" && continue

    cmd app_hibernation set-state --user 0 --global "$app" true >/dev/null 2>&1 || true
    cmd appops set "$app" RUN_IN_BACKGROUND ignore >/dev/null 2>&1 || true
    cmd appops set "$app" RUN_ANY_IN_BACKGROUND ignore >/dev/null 2>&1 || true
    am set-standby-bucket "$app" restricted >/dev/null 2>&1 || true
done

# Global configs (kept outside loop for efficiency)
device_config put app_hibernation app_hibernation_enabled true >/dev/null 2>&1 || true
device_config put permissions auto_revoke_unused_threshold_millis2 99 >/dev/null 2>&1 || true
}
