#!/system/bin/sh

# LITE MODE

MOD_DIR="/data/adb/modules/MTK_AI"
BB="$MOD_DIR/busybox"
EXTERNAL_CFG="/sdcard/MTK_AI_Engine"
NOTIFY_ENABLED_FILE="$EXTERNAL_CFG/enable_notifications"
TOUCH_ACTIVE="$EXTERNAL_CFG/enable_limiter"

# --- NOTIFICATION FUNCTION ---
# Uses UID 2000 to bypass SELinux restrictions
notify_status() {
    # Skip if notification toggle is OFF
    [ ! -f "$NOTIFY_ENABLED_FILE" ] && return 0

    # --- 0. Determine Mode, Icon, and Title ---
    if [ -f /dev/.mtk_ai_active_game ]; then
        # Use file:// prefix and lowercase -i for the status bar icon
        ICON="file:///data/local/tmp/gaming_icon.png"
        TITLE="Gaming Mode"
    else
        ICON="file:///data/local/tmp/icon.png"
        TITLE="Normal Mode"
    fi

    # --- 1. Temperature ---
    RAW_TEMP=$(cat /sys/class/power_supply/battery/temp 2>/dev/null || echo "0")
    B_TEMP="$((RAW_TEMP / 10)).$((RAW_TEMP % 10))°C"

    # --- 2. Governor ---
    GOV_FILE="/sys/devices/system/cpu/cpufreq/policy0/scaling_governor"
    [ ! -f "$GOV_FILE" ] && GOV_FILE="/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor"
    CPU_GOV="Unknown"
    [ -f "$GOV_FILE" ] && CPU_GOV=$(cat "$GOV_FILE" 2>/dev/null | tr -d '[:space:]')

    local status_msg="$1"
    local full_msg="$status_msg | Gov: $CPU_GOV | Temp: $B_TEMP"

    # --- 4. Post Notification ---
    # -i (lowercase) puts the icon ON TOP in the status bar.
    # file:// prefix is REQUIRED for local paths.
    su -lp 2000 -c "cmd notification post -t '$TITLE' -i '$ICON' -S bigtext mtk_ai_tag '$full_msg'" >/dev/null 2>&1
}

touch_active() {
if [ -f "$EXTERNAL_CFG/enable_lite_gaming" ] && [ -f "/dev/.mtk_ai_active_game" ]; then
nohup sh /data/adb/modules/MTK_AI/Xperformance/etc/auto_frequency/auto_frequency.sh >/dev/null 2>&1 &
fi
ps 2>/dev/null | grep -v grep | grep -qw "mtk_ai_engine" && return 0
[ -f "/dev/.mtk_ai_active_game" ] && return 0

    CPU_SYS="/sys/devices/system/cpu"

    # Replace the existing frequency setting with:
TOUCH_ACTIVE_PERCENT=100
if [ -f "/sdcard/MTK_AI_Engine/manual_touch_active_freq.txt" ]; then
    TOUCH_ACTIVE_PERCENT=$(cat "/sdcard/MTK_AI_Engine/manual_touch_active_freq.txt" | tr -d '\r\n ')
    # Validate range
    if [ "$TOUCH_ACTIVE_PERCENT" -lt 50 ] 2>/dev/null; then TOUCH_ACTIVE_PERCENT=50; fi
    if [ "$TOUCH_ACTIVE_PERCENT" -gt 100 ] 2>/dev/null; then TOUCH_ACTIVE_PERCENT=100; fi
fi

# Target only BIG cores (policy4, policy6, policy7 cover most MTK layouts)
for policy in $CPU_SYS/cpufreq/policy4 $CPU_SYS/cpufreq/policy6 $CPU_SYS/cpufreq/policy7; do
    [ -d "$policy" ] || continue
    
    if [ -f "$policy/cpuinfo_max_freq" ]; then
        MAX_FREQ=$(cat "$policy/cpuinfo_max_freq")
        TARGET_MAX=$((MAX_FREQ * TOUCH_ACTIVE_PERCENT / 100))
        
        chmod 644 "$policy/scaling_max_freq" 2>/dev/null
        echo "$TARGET_MAX" > "$policy/scaling_max_freq"
    fi
done

sync
}

touch_inactive() {
if [ -f "$EXTERNAL_CFG/enable_lite_gaming" ] && [ -f "/dev/.mtk_ai_active_game" ]; then
nohup sh /data/adb/modules/MTK_AI/Xperformance/etc/auto_frequency/auto_frequency.sh >/dev/null 2>&1 &
fi
[ ! -f "$TOUCH_ACTIVE" ] && return 0
ps 2>/dev/null | grep -v grep | grep -qw "mtk_ai_engine" && return 0
[ -f "/dev/.mtk_ai_active_game" ] && return 0

    CPU_SYS="/sys/devices/system/cpu" # Added for safety in case it's not global

    INACTIVE_PERCENT=30
    if [ -f "/sdcard/MTK_AI_Engine/manual_inactive_freq.txt" ]; then
        INACTIVE_PERCENT=$(cat "/sdcard/MTK_AI_Engine/manual_inactive_freq.txt" | tr -d '\r\n ')
        # Enforce 25-50% range
        if [ "$INACTIVE_PERCENT" -lt 25 ] 2>/dev/null; then
            INACTIVE_PERCENT=25
        elif [ "$INACTIVE_PERCENT" -gt 50 ] 2>/dev/null; then
            INACTIVE_PERCENT=50
        fi
    fi

    # Target only BIG cores for maximum power saving / thermal control
    for policy in $CPU_SYS/cpufreq/policy4 $CPU_SYS/cpufreq/policy6 $CPU_SYS/cpufreq/policy7; do
        [ -d "$policy" ] || continue
        
        if [ -f "$policy/cpuinfo_max_freq" ]; then
            max_val=$(cat "$policy/cpuinfo_max_freq")
            target_val=$(( max_val * INACTIVE_PERCENT / 100 ))
            
            chmod 644 "$policy/scaling_max_freq" 2>/dev/null
            echo "$target_val" > "$policy/scaling_max_freq"
        fi
    done

    sync
}

force_kill() {
CONFIG_DIR="/sdcard/MTK_AI_Engine/config"
FORCE_KILL_FILE="${CONFIG_DIR}/force_kill.list"
NEVER_KILL_FILE="${CONFIG_DIR}/never_kill.list"

# Critical apps that must NEVER be killed (from hibernator.js)
CRITICAL_APPS="
com.android.systemui
com.android.bluetooth
com.android.phone
com.android.stk
com.google.android.gms
com.google.android.gsf
com.google.android.packageinstaller
com.android.settings
com.google.android.setupwizard
com.android.launcher3
com.google.android.inputmethod.latin
android
com.android.providers.settings
com.android.providers.downloads
com.android.providers.media.module
com.android.externalstorage
com.android.documentsui
com.android.permissioncontroller
com.android.vending
com.google.android.webview
"

# Critical prefixes (apps starting with these are protected)
CRITICAL_PREFIXES="android.hardware. android.system. vendor. com.android.system"

mkdir -p "$CONFIG_DIR"

is_critical() {
    local pkg="$1"
    # Check exact match
    for critical in $CRITICAL_APPS; do
        [ "$pkg" = "$critical" ] && return 0
    done
    # Check prefix match
    for prefix in $CRITICAL_PREFIXES; do
        case "$pkg" in
            ${prefix}*) return 0 ;;
        esac
    done
    return 1
}

get_current_app() {
    # 🎯 Extract current top app package name
    local top_app=$(dumpsys activity activities 2>/dev/null | grep -m1 'mResumedActivity' | grep -oE '[a-zA-Z0-9_]+(\.[a-zA-Z0-9_]+)+' | head -n 1)
    
    if [ -z "$top_app" ]; then
        top_app=$(dumpsys activity activities 2>/dev/null | grep -m1 'mFocusedApp' | grep -oE '[a-zA-Z0-9_]+(\.[a-zA-Z0-9_]+)+' | head -n 1)
    fi
    
    if [ -z "$top_app" ]; then
        top_app=$(dumpsys window 2>/dev/null | grep -m1 'mCurrentFocus' | grep -oE '[a-zA-Z0-9_]+(\.[a-zA-Z0-9_]+)+' | head -n 1)
    fi
    
    # ✅ Validate package name format (allows uppercase)
    if echo "$top_app" | grep -qE '^[a-zA-Z][a-zA-Z0-9_]*(\.[a-zA-Z0-9_]+)+$'; then
        echo "$top_app"
    fi
}

echo "📦 Fetching installed packages..."
ALL_PACKAGES=$(pm list packages 2>/dev/null | cut -d: -f2 | sort -u)

if [ -z "$ALL_PACKAGES" ]; then
    echo "❌ Failed to get package list. Are you root?"
    exit 1
fi

TOTAL=$(echo "$ALL_PACKAGES" | wc -l)
echo "📊 Total installed packages: $TOTAL"

# Detect current top app
echo "🎯 Detecting current top app..."
CURRENT_APP=$(get_current_app)
if [ -n "$CURRENT_APP" ]; then
    echo "✅ Current top app: $CURRENT_APP"
else
    echo "⚠️ Could not detect current top app"
fi

is_in_never_kill() {
    [ -f "$NEVER_KILL_FILE" ] && grep -Fqx -- "$1" "$NEVER_KILL_FILE"
}

# 1. 🛡️ ADD current app to Never Kill list
if [ -n "$CURRENT_APP" ] && ! is_critical "$CURRENT_APP"; then
    if is_in_never_kill "$CURRENT_APP"; then
        echo "ℹ️ Current app already protected: $CURRENT_APP"
    else
        echo "$CURRENT_APP" >> "$NEVER_KILL_FILE"
        echo "🛡️ Added current app to Never Kill list: $CURRENT_APP"
    fi
fi

# Initialize lists for Force Kill
FORCE_LIST=""
ADDED_FORCE=0
SKIPPED=0

# 2. Add all non-critical apps to Force Kill list
for pkg in $ALL_PACKAGES; do
    pkg=$(echo "$pkg" | tr -d '[:space:]')
    [ -z "$pkg" ] && continue

    # Skip current app
    [ "$pkg" = "$CURRENT_APP" ] && continue

    # Skip packages already protected in Never Kill file
    if is_in_never_kill "$pkg"; then
        SKIPPED=$((SKIPPED + 1))
        continue
    fi

    if is_critical "$pkg"; then
        SKIPPED=$((SKIPPED + 1))
    else
        if [ -z "$FORCE_LIST" ]; then
            FORCE_LIST="$pkg"
        else
            FORCE_LIST="${FORCE_LIST}
${pkg}"
        fi
        ADDED_FORCE=$((ADDED_FORCE + 1))
    fi
done

# Write Force Kill file
if [ -n "$FORCE_LIST" ]; then
    printf '%s\n' "$FORCE_LIST" > "$FORCE_KILL_FILE"
else
    : > "$FORCE_KILL_FILE"
fi

echo "⚡ Added $ADDED_FORCE apps to Force Kill list"
echo "⏭️ Skipped $SKIPPED apps"

# ⚠️ Note: NEVER_KILL_FILE is intentionally NOT overwritten here to preserve your existing protections!

touch /sdcard/MTK_AI_Engine/enable_cleaner

echo "🛡️ Skipped $SKIPPED critical system apps"
echo "✅ Done! Configs saved to $CONFIG_DIR"
}

refresh_rate() {
    # --- Execute per-app refresh rate ---
    REFRESH_FILE="/sdcard/MTK_AI_Engine/manual_refresh_lock.txt"
    MODE_FILE="/sdcard/MTK_AI_Engine/refresh_locks/${CURRENT_TOP_APP}.mode"

    # 1. Read the global mode ID (strip spaces, tabs, newlines)
    MODE_ID=""
    if [ -f "$REFRESH_FILE" ]; then
        MODE_ID=$(cat "$REFRESH_FILE" 2>/dev/null | tr -d '[:space:]')
    fi

    # 2. Determine which mode to apply (Per-app vs Global)
    TARGET_MODE=""
    if [ -f "$MODE_FILE" ]; then
        # Read the per-app mode ID
        MODE=$(cat "$MODE_FILE" 2>/dev/null | tr -d '[:space:]')
        
        if [ -n "$MODE" ]; then
            TARGET_MODE="$MODE"      # Use per-app mode if valid
        else
            TARGET_MODE="$MODE_ID"   # Fallback to global if per-app file is empty
        fi
    else
        TARGET_MODE="$MODE_ID"       # Fallback to global if per-app file doesn't exist
    fi

    # 3. Execute the refresh rate change ONLY if we have a valid mode
    if [ -n "$TARGET_MODE" ]; then
        service call SurfaceFlinger 1035 i32 "$TARGET_MODE"
    fi
    # -----------------------------------------
}

exclude_killing() {
    # Get all PIDs under MTK_AI
    for pid in $(pgrep -f "/data/adb/modules/MTK_AI"); do
        cmdline=$(cat /proc/$pid/cmdline 2>/dev/null | tr '\0' ' ')
        
        # Exclude if cmdline contains action.sh, powersavex, or is inside the lib/lib64 folders
        # The trailing '/' ensures we match the folder path, not just a filename starting with 'lib'
        if ! echo "$cmdline" | grep -qE "action\.sh|powersavex|/data/adb/modules/MTK_AI/lib(64)?/"; then
            kill -9 $pid 2>/dev/null
        fi
    done
}

game_api() {
local DIR="/sdcard/MTK_AI_Engine/per_app"
    [ -d "$DIR" ] || return
    local APPLIED=" "

    for f in "$DIR"/*; do
        [ -f "$f" ] || continue
        local p="${f##*/}"; p="${p%.*}"
        case "$APPLIED" in *" $p "*) continue;; esac
        APPLIED="$APPLIED$p "

        local ds=$(cat "$DIR/$p.downscale" 2>/dev/null | tr -d '[:space:]')
        ds=${ds:-100}; local ds_f=$(awk "BEGIN{printf \"%.1f\",$ds/100}")

        local fps=$(cat "$DIR/$p.fps" 2>/dev/null | tr -d '[:space:]')
        fps=${fps:-0}; local fps_str=""; [ "$fps" -gt 0 ] 2>/dev/null && fps_str="$fps"

        local angle=$(cat "$DIR/$p.use_angle" 2>/dev/null | tr -d '[:space:]')
        local angle_str="false"; [ "$angle" = "1" ] && angle_str="true"

        local boost=$(cat "$DIR/$p.loading_boost" 2>/dev/null | tr -d '[:space:]')
        boost=${boost:--1}
        
        cmd game reset "$p" 2>/dev/null

        device_config put game_overlay "$p" "mode=2,downscaleFactor=1.0,useAngle=false,loadingBoost=-1:mode=4,downscaleFactor=${ds_f},fps=${fps_str},useAngle=${angle_str},loadingBoost=${boost}"

        local gm=$(cat "$DIR/$p.gamemode" 2>/dev/null | tr -d '[:space:]')
        [ -n "$gm" ] && cmd game mode "$gm" "$p" 2>/dev/null
    done
}

game_mode() {
force_kill
nohup sh "/data/adb/modules/MTK_AI/MTK_AI/AI_MODE/gaming_mode/app_optimizer" >/dev/null 2>&1 &
if [ -f "$EXTERNAL_CFG/enable_gaming_prop" ]; then
    nohup "$MOD_DIR/MTK_AI/AI_MODE/gaming_mode/gaming_prop" >/dev/null 2>&1 &
fi
if [ -f "$EXTERNAL_CFG/enable_gaming_prop2" ]; then
    nohup "$MOD_DIR/MTK_AI/AI_MODE/gaming_mode/gaming_prop_2" >/dev/null 2>&1 &
fi
if [ -f "$EXTERNAL_CFG/enable_disable_thermal" ]; then
    nohup "$MOD_DIR/MTK_AI/AI_MODE/gaming_mode/disable_thermal" >/dev/null 2>&1 &
fi
if [ -f "$EXTERNAL_CFG/enable_performance" ]; then
    nohup "$MOD_DIR/MTK_AI/AI_MODE/gaming_mode/performance" >/dev/null 2>&1 &
fi
if [ -f "$EXTERNAL_CFG/enable_lite_gaming" ]; then
    nohup "$MOD_DIR/MTK_AI/AI_MODE/gaming_mode/lite_gaming" >/dev/null 2>&1 &
fi
}

normal_mode() {
APP=$(head -n 1 /dev/.mtk_ai_active_game 2>/dev/null | tr -d '[:space:]') && [ -n "$APP" ] && { grep -Fvx "$APP" /sdcard/MTK_AI_Engine/config/never_kill.list > /sdcard/MTK_AI_Engine/config/never_kill.tmp || true; mv /sdcard/MTK_AI_Engine/config/never_kill.tmp /sdcard/MTK_AI_Engine/config/never_kill.list; }
force_kill
nohup sh "/data/adb/modules/MTK_AI/MTK_AI/AI_MODE/normal_mode/normal_prop" >/dev/null 2>&1 &
if [ -f "$EXTERNAL_CFG/use_tweaks" ]; then
nohup sh "/data/adb/modules/MTK_AI/MTK_AI/AI_MODE/normal_mode/normal_cpuset" >/dev/null 2>&1 &
fi
}

is_game_background() {
    local pkg="$1"

    local pids
    pids=$(pidof "$pkg" 2>/dev/null)

    [ -z "$pids" ] && return 0

    return 1
}

is_temporary_overlay() {
    case "$1" in
        com.android.systemui|com.android.systemui.*)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

current_app() {
    # 1. Run dumpsys ONLY ONCE per cycle and cache it. 
    # This is the heaviest command, so we never want to run it twice.
    local DUMP
    DUMP=$(dumpsys activity activities 2>/dev/null)

    if [ -f /dev/.mtk_ai_active_game ]; then
        ACTIVE_GAME=$(cat /dev/.mtk_ai_active_game 2>/dev/null)

        if is_game_background "$ACTIVE_GAME"; then
            rm -f /dev/.mtk_ai_active_game /dev/.mtk_ai_bg_count
            log_msg "🎮 $ACTIVE_GAME process ended, exiting gaming mode"
            normal_mode
            notify_status "Normal mode"
            return 0
        fi

        # Extract top app from the cached DUMP (no extra dumpsys calls)
        CURRENT_TOP_APP=$(echo "$DUMP" | grep -m1 -E 'mResumedActivity|mFocusedApp' | grep -oE '[a-zA-Z0-9_]+(\.[a-zA-Z0-9_]+)+' | head -n 1)

        if is_temporary_overlay "$CURRENT_TOP_APP"; then
            log_msg "🎮 Temporary SystemUI overlay detected, keeping gaming mode"
            return 0
        fi

        if [ "$CURRENT_TOP_APP" = "$ACTIVE_GAME" ]; then
            rm -f /dev/.mtk_ai_bg_count
            return 0
        fi

        # Something else is temporarily in front
        bg_count=$(cat /dev/.mtk_ai_bg_count 2>/dev/null)
        bg_count=${bg_count:-0} # Shell built-in default, avoids forking 'echo 0'
        bg_count=$((bg_count + 1))
        echo "$bg_count" > /dev/.mtk_ai_bg_count 2>/dev/null

        if [ "$bg_count" -lt 5 ]; then
            log_msg "⏳ $ACTIVE_GAME temporarily covered ($bg_count/5), keeping gaming mode"
            return 0
        fi

        # Other app has really replaced the game
        log_msg "📉 $ACTIVE_GAME left foreground (${bg_count}x), exiting gaming mode"
        rm -f /dev/.mtk_ai_active_game /dev/.mtk_ai_bg_count
        notify_status "Normal mode"
        normal_mode
        return 0
    fi

    # NO ACTIVE GAME
    CURRENT_TOP_APP=$(echo "$DUMP" | grep -m1 -E 'mResumedActivity|mFocusedApp' | grep -oE '[a-zA-Z0-9_]+(\.[a-zA-Z0-9_]+)+' | head -n 1)

    if [ -z "$CURRENT_TOP_APP" ]; then
        return 0
    fi

    notify_status "$CURRENT_TOP_APP"
    refresh_rate

    # GAME DETECTION
    # Use grep -qFx instead of awk. It's much faster and uses almost zero CPU.
    # IMPORTANT: Move game_list.txt out of /sdcard/ to avoid FUSE overhead!
    local GAME_LIST="/sdcard/MTK_AI_Engine/game_list.txt" # <-- UPDATE THIS PATH
    
    if grep -qFx "$CURRENT_TOP_APP" "$GAME_LIST" 2>/dev/null; then
        echo "$CURRENT_TOP_APP" > /dev/.mtk_ai_active_game
        rm -f /dev/.mtk_ai_bg_count
        game_mode
        notify_status "Gaming🎮: $CURRENT_TOP_APP"
        refresh_rate
    fi
}
