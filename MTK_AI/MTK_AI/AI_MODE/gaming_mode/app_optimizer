#!/system/bin/sh

pkill -f normal_prop >/dev/null 2>&1 || true
# ==========================================
# KILL PREVIOUS RUNNING INSTANCE
# ==========================================
PID_FILE="/data/local/tmp/app_optimizer.pid"
if [ -f "$PID_FILE" ]; then
    OLD_PID=$(cat "$PID_FILE" 2>/dev/null)
    # If an old PID exists and it's not the current script ($$), force kill it
    if [ -n "$OLD_PID" ] && [ "$OLD_PID" != "$$" ]; then
        kill -9 "$OLD_PID" 2>/dev/null
    fi
fi
# Save the current script's PID for the next run to find
echo $$ > "$PID_FILE"
# ==========================================

# Fallback to BusyBox sh if available for better POSIX compliance
CONFIG_DIR="/sdcard/MTK_AI_Engine"
CONFIG_FILE="$CONFIG_DIR/devfreq_config.conf"
LOG_FILE="$CONFIG_DIR/MTK_AI_Engine.log"
CPULIMIT="/data/adb/modules/MTK_AI/lib/cpulimit"
CPU_SYS="/sys/devices/system/cpu"

log_msg() {
    if [ -f "/sdcard/MTK_AI_Engine/disable_log" ]; then
        echo "log disabled"
    else
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "$LOG_FILE" 2>/dev/null || echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1"
    fi
}

# Dynamically find and set boost_affinity to 1 (Force Big/Super Cores)
for f in $(find /sys/ -name "boost_affinity" 2>/dev/null); do
    echo 1 > "$f"
done

# Boost foreground 
setprop persist.sys.foreground_boost 1

# Prevent FPS going down
cmd display set-match-content-frame-rate-pref 0

# Powermode
cmd power set-mode 2 true
cmd power set-fixed-performance-mode-enabled true
settings put global power_manager_constants fixed_performance_mode=true
setprop 'persist.sys.power_mode_perf' '1' || true
settings put system persist.sys.power_mode_perf 1 2>/dev/null || true
setprop 'persist.sys.perf_boost_enabled' '1' || true
setprop 'persist.sys.perf_mode' '1' || true
setprop 'persist.sys.performance' '1' || true
setprop 'persist.sys.performance_mode' '1' || true
setprop 'sys.hwc.gpu_perf_mode' '1' || true
setprop 'vendor.perf.framepacing.enable' '1' || true
setprop 'vendor.performance.gbe' '1' || true
settings put global 'sustained_performance_mode_enabled' '1'

# Disable Vsync
if [ -f "$CONFIG_DIR/disable_vsync" ]; then
    setprop debug.hwui.disable_vsync true
fi

# Optimize app launch 
cmd device_config put runtime_native_boot iorap_perfetto_enable true
cmd device_config put runtime_native_boot iorap_readahead_enable true

# ==============================
# 🗄️ I/O Scheduler & Read-Ahead
# ==============================
find /sys \( -name "read_ahead_kb" -o -name "scheduler" \) ! -type d 2>/dev/null | while IFS= read -r file; do
    chmod 777 "$file" 2>/dev/null || true
    case "$file" in
        *read_ahead_kb) echo 8192 | tee "$file" 2>/dev/null || true ;;
        *scheduler)     echo none  | tee "$file" 2>/dev/null || true ;;
    esac
done

log_msg "→ Applying Gaming EEM offsets from sdcard..."
for i in b:/proc/eem/EEM_DET_B/eem_offset l:/proc/eem/EEM_DET_L/eem_offset cci:/proc/eem/EEM_DET_CCI/eem_offset bl:/proc/eem/EEM_DET_BL/eem_offset gpu:/proc/eemg/EEMG_DET_GPU/eemg_offset gpu_hi:/proc/eemg/EEMG_DET_GPU_HI/eemg_offset; do
    k=${i%%:*}; p=${i#*:}; v=$(cat /sdcard/MTK_AI_Engine/eem_offsets/gaming/$k.txt 2>/dev/null)
    [ -n "$v" ] && echo "$v" > "$p" 2>/dev/null && log_msg "[✓] $k: ${v}mV"
done || true

# ==============================
# ⚡ CPU/CCI Power Mode
# ==============================
if [ -f "$CONFIG_DIR/cpufreq_mode" ]; then
    echo "3" > /proc/cpufreq/cpufreq_power_mode 2>/dev/null || true
    echo "1" > /proc/cpufreq/cpufreq_cci_mode 2>/dev/null || true
fi

#DND
if [ -f "$CONFIG_DIR/enable_dnd_during_game" ]; then
    cmd notification set_dnd priority
fi

#VM Memory & Scheduler optimize
if [ -f "$CONFIG_DIR/sysctl_tweaks" ]; then
for param in \
  "vm.admin_reserve_kbytes=8192" \
  "vm.block_dump=0" \
  "vm.compact_unevictable_allowed=1" \
  "vm.compaction_proactiveness=20" \
  "vm.dirty_background_bytes=0" \
  "vm.dirty_background_ratio=5" \
  "vm.dirty_bytes=0" \
  "vm.dirty_expire_centisecs=500" \
  "vm.dirty_ratio=20" \
  "vm.dirty_writeback_centisecs=500" \
  "vm.dirtytime_expire_seconds=43200" \
  "vm.extfrag_threshold=500" \
  "vm.extra_free_kbytes=0" \
  "vm.laptop_mode=0" \
  "vm.legacy_va_layout=0" \
  "vm.lowmem_reserve_ratio=256 32 0" \
  "vm.max_map_count=65530" \
  "vm.min_free_kbytes=65536" \
  "vm.mmap_min_addr=32768" \
  "vm.mmap_rnd_bits=24" \
  "vm.mmap_rnd_compat_bits=11" \
  "vm.oom_dump_tasks=1" \
  "vm.oom_kill_allocating_task=0" \
  "vm.overcommit_kbytes=0" \
  "vm.overcommit_memory=0" \
  "vm.overcommit_ratio=50" \
  "vm.page-cluster=3" \
  "vm.page_lock_unfairness=5" \
  "vm.panic_on_oom=0" \
  "vm.percpu_pagelist_fraction=0" \
  "vm.stat_interval=60" \
  "vm.swappiness=10" \
  "vm.unprivileged_userfaultfd=0" \
  "vm.user_reserve_kbytes=131072" \
  "vm.vfs_cache_pressure=50" \
  "vm.watermark_boost_factor=0" \
  "vm.watermark_scale_factor=10" \
  "kernel.sched_schedstats=0" \
  "kernel.sched_util_clamp_min=0" \
  "kernel.sched_pelt_multiplier=1" \
  "kernel.sched_latency_ns=2000000" \
  "kernel.sched_min_granularity_ns=500000" \
  "kernel.sched_wakeup_granularity_ns=500000" \
  "kernel.sched_migration_cost_ns=500000" \
  "kernel.sched_tunable_scaling=0" \
  "kernel.sched_nr_migrate=32" \
  "kernel.sched_rr_timeslice_ms=100" \
  "kernel.sched_rt_period_us=1000000" \
  "kernel.sched_rt_runtime_us=950000" \
  "kernel.sched_util_clamp_max=1024" \
  "kernel.sched_util_clamp_min_rt_default=0" \
  "kernel.sched_energy_aware=1" \
  "kernel.sched_child_runs_first=0"
do
    # Added || true at the end to force a successful exit code and prevent script halting
    sysctl -w "$param" > /dev/null 2>&1 || echo "^^^ FAILED: $param" || true
done
fi

#Thermal Override
find /sys -path "*/thermal/cooling_device*/cur_state" -exec chmod 444 {} + 2>/dev/null || true
find /sys -path '*/thermal/thermal_zone*/mode' -exec sh -c 'echo disabled > "$1" 2>/dev/null || true' _ {} \;
find /sys/class/thermal/ -type f -name "cdev*_weight" -exec sh -c 'for f; do chmod 664 "$f" 2>/dev/null; echo 0 > "$f" 2>/dev/null; done' _ {} +
cmd thermalservice override-status 1 2>/dev/null

# Prevent FPS going down
cmd display set-match-content-frame-rate-pref 0

# Lock other devfreq nodes to max
for dev in /sys/class/devfreq/*; do
    [ -d "$dev" ] || continue
    name=$(basename "$dev")
    case "$name" in *mem*|*dvfs*|*dmc*|*gpu*|*mali*|*gpubw*) continue ;; esac
    max_freq=$(awk '{print $NF}' "$dev/available_frequencies" 2>/dev/null)
    [ -z "$max_freq" ] && continue
    echo "$max_freq" > "$dev/min_freq" 2>/dev/null
    echo "$max_freq" > "$dev/max_freq" 2>/dev/null
done

#External Scripts
[ -f /sdcard/MTK_AI_Engine/enable_gaming_prop ] && sh /data/adb/modules/MTK_AI/MTK_AI/AI_MODE/gaming_mode/gaming_prop || true
[ -f /sdcard/MTK_AI_Engine/enable_gaming_prop2 ] && sh /data/adb/modules/MTK_AI/MTK_AI/AI_MODE/gaming_mode/gaming_prop_2 || true
[ -f /sdcard/MTK_AI_Engine/enable_performance ] && sh /data/adb/modules/MTK_AI/MTK_AI/AI_MODE/gaming_mode/performance || true
[ -f /sdcard/MTK_AI_Engine/enable_disable_thermal ] && sh /data/adb/modules/MTK_AI/MTK_AI/AI_MODE/gaming_mode/disable_thermal || true
nohup sh "/sdcard/MTK_AI_Engine/modes/gaming_mode.sh" >/dev/null 2>&1 &
nohup sh "/sdcard/MTK_AI_Engine/setedit-modes/gaming.sh" >/dev/null 2>&1 &
nohup sh "/data/adb/modules/MTK_AI/MTK_AI/AI_MODE/global_mode/ram_cleaner" 2>/dev/null &
pkill -f cpulimit >/dev/null 2>&1 || true
