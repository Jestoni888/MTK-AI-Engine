#!/system/bin/sh
# --- LITE GAMING DAEMON ---

# ==============================
# 🚀 PPM Policy Configuration (Fixed for /system/bin/sh)
# ==============================

LOG_FILE="/sdcard/MTK_AI_Engine/MTK_AI_Engine.log"
PPM_PATH="/proc/ppm/policy_status"

# Ensure directory exists for logging
mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null

log_action() {
    echo "[$(date +"%Y-%m-%d %H:%M:%S")] $1" >> "$LOG_FILE"
}

for q in /sys/block/*/queue; do 
  echo 4096|tee $q/read_ahead_kb 2>/dev/null
  echo none|tee $q/scheduler 2>/dev/null
done

for d in /sys/class/devfreq/*/; do
  f=$(awk '{print $NF}' "$d/available_frequencies" 2>/dev/null)
  [ -n "$f" ] && echo $f | tee "$d/max_freq" 2>/dev/null
done
echo "4 0" > /proc/ppm/policy_status 2>/dev/null || true
echo disabled|tee /sys/devices/virtual/thermal/thermal_zone*/mode
