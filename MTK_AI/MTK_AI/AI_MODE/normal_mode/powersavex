#!/system/bin/sh

### === SINGLE INSTANCE LOCK ===
LOCK_DIR="/data/adb/modules/MTK_AI/.guard"
mkdir -p "$LOCK_DIR"
LOCK_FILE="$LOCK_DIR/powersave_runner.pid"

# Helper: safe logging (works on all Android versions)
log_msg() { log -t MTK_AI "$@" 2>/dev/null || echo "[MTK_AI] $*"; }

# 1️⃣ Global pgrep check FIRST
if pgrep -f "powersavex" | grep -v "^$$" > /dev/null 2>&1; then
    exit 0
else
    rm -rf "$LOCK_DIR"
fi

# 2️⃣ If PID file exists and process is alive → exit silently
if [ -f "$LOCK_FILE" ]; then
    OLD_PID=$(cat "$LOCK_FILE" 2>/dev/null)
    if [ -n "$OLD_PID" ] && kill -0 "$OLD_PID" 2>/dev/null; then
        exit 0
    fi
fi

# 3️⃣ Register current process as the single instance
mkdir -p "$LOCK_DIR"
echo $$ > "$LOCK_FILE"
trap 'rm -f "$LOCK_FILE"' EXIT
### ============================

export LD_LIBRARY_PATH=/data/adb/modules/MTK_AI/lib64:/data/adb/modules/MTK_AI/lib:$LD_LIBRARY_PATH
. /data/adb/modules/MTK_AI/MTK_AI/AI_MODE/auto_frequency/auto_frequency
INOTIFY="/data/adb/modules/MTK_AI/lib/inotifywait"
POWERSAVE="/data/adb/modules/MTK_AI/MTK_AI/AI_MODE/normal_mode/powersave"
MANUAL="/data/adb/modules/MTK_AI/script_runner/mtk_ai_manual"

# Dynamically find all 'brightness' files in /sys/
BRIGHTNESS_FILES=$(find /sys -name "brightness" -type f 2>/dev/null)

if [ -z "$BRIGHTNESS_FILES" ]; then
    echo "No brightness files found in /sys/"
    exit 1
fi

# Function to check state and launch the correct script
apply_mode() {
    all_zero=true
    
    # Iterate through all dynamically found brightness files
    for file in $BRIGHTNESS_FILES; do
        STATE=$(cat "$file" 2>/dev/null)
        # If any file has a value other than 0 (and is not empty), screen is considered ON
        if [ -n "$STATE" ] && [ "$STATE" != "0" ]; then
            all_zero=false
            break
        fi
    done
    
    if [ "$all_zero" = true ]; then
        # Screen is OFF (all values are 0) -> Apply powersave mode if enabled
        if [ -f "/sdcard/MTK_AI_Engine/low_power_mode" ]; then
            "$POWERSAVE" &
        fi
        if [ -f "/sdcard/MTK_AI_Engine/auto_update" ]; then
            nohup sh "/data/adb/modules/MTK_AI/action.sh" >/dev/null 2>&1 &
        fi
        exclude_killing
    else
        # Screen is ON (at least one value > 0) -> Apply manual/performance mode
        "$MANUAL" &
        if [ ! -f "/sdcard/MTK_AI_Engine/auto_update" ]; then
            nohup sh "/data/adb/modules/MTK_AI/update_checker.sh" >/dev/null 2>&1 &
        fi
        nohup sh "/data/adb/modules/MTK_AI/service.sh" >/dev/null 2>&1 &
    fi
}

# Apply the correct mode immediately on script startup
apply_mode

# Start monitoring all found files for changes using your custom inotifywait
# -m : monitor mode (keeps the process alive to watch for future events)
# -e modify : trigger when the file content is modified
# -q : quiet mode (reduces output overhead)
# $BRIGHTNESS_FILES expands to all found file paths
"$INOTIFY" -m -e modify -q $BRIGHTNESS_FILES | while read -r dir event file; do
    apply_mode
done
