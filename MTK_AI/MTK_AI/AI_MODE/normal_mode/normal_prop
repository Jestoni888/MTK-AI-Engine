#!/system/bin/sh
[ -f "/dev/.mtk_ai_normal_mode" ] && return 0
pkill -f app_optimizer >/dev/null 2>&1 || true

# --- LOCKFILE TO PREVENT SPAM ---
LOCKFILE="/dev/.mtk_ai_normal.lock"
if [ -f "$LOCKFILE" ]; then
    kill -0 $(cat "$LOCKFILE") 2>/dev/null && exit 0
fi
echo $$ > "$LOCKFILE"
trap 'rm -f "$LOCKFILE"' EXIT
# --------------------------------
# ==========================================
. /data/adb/modules/MTK_AI/script_runner/mtk_ai_manual
LOG_FILE="/sdcard/MTK_AI_Engine/MTK_AI_Engine.log"

log_msg() {
if [ -f "/sdcard/MTK_AI_Engine/disable_log" ]; then
  echo "log disabled"
else
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$LOG_FILE" || true
fi
}
SDCARD="/sdcard/MTK_AI_Engine"
BB="/data/adb/modules/MTK_AI/busybox"
SAVE_DIR="$SDCARD/cooldown_values"

if [ -f "$SDCARD/devfreq_config.json" ] && [ -f "$SDCARD/devfreq_other_config.json" ]; then
devfreq
else
nohup sh "/data/adb/modules/MTK_AI/MTK_AI/AI_MODE/normal_mode/default_dvfs.sh" >/dev/null 2>&1 &
fi

# DND
if [ -f "$SDCARD/enable_dnd_during_game" ]; then
    cmd statusbar send-disable-flag none
    cmd notification set_dnd off
    settings put global heads_up_notifications_enabled 1
fi

# unsuspend background apps
D="/sdcard/MTK_AI_Engine"
[ -f "$D/suspend_bg" ] && [ -s "$D/suspended_apps" ] && {
    while IFS= read -r p || [ -n "$p" ]; do
        p="${p//$'\r'/}"
        # Added "< /dev/null" to stop pm from eating the rest of the file
        [ -n "$p" ] && [ ! -f "$D/freeze/$p" ] && pm unsuspend "$p" < /dev/null 2>/dev/null
    done < "$D/suspended_apps"
    > "$D/suspended_apps"
}

# Revert Game Driver settings
cmd device_config delete game_driver game_driver_all_apps
cmd device_config delete game_driver enable_game_driver
cmd device_config delete game_driver app_driver_opt_in

# Revert Updatable GPU Driver settings
cmd device_config delete gpu updatable_driver_production_opt_in_apps

# Revert SurfaceFlinger Context Priority
cmd device_config delete surface_flinger_native_boot use_context_priority

# Remove Vsync
su -c resetprop -d debug.hwui.disable_vsync 2>/dev/null

echo "-1" > /proc/gpufreqv2/fix_target_opp_index 2>/dev/null
echo "-1" > /proc/gpufreq/gpufreq_opp_dump 2>/dev/null

nohup sh "/sdcard/MTK_AI_Engine/modes/normal_mode.sh" >/dev/null 2>&1 &
nohup sh "/sdcard/MTK_AI_Engine/setedit-modes/normal.sh" >/dev/null 2>&1 &
nohup sh "/data/adb/modules/MTK_AI/MTK_AI/AI_MODE/normal_mode/stock_tweaks.sh" >/dev/null 2>&1 &

log_msg "→ Applying Normal EEM offsets from sdcard..."
for i in b:/proc/eem/EEM_DET_B/eem_offset l:/proc/eem/EEM_DET_L/eem_offset cci:/proc/eem/EEM_DET_CCI/eem_offset bl:/proc/eem/EEM_DET_BL/eem_offset gpu:/proc/eemg/EEMG_DET_GPU/eemg_offset gpu_hi:/proc/eemg/EEMG_DET_GPU_HI/eemg_offset; do
  k=${i%%:*}; p=${i#*:}; v=$(cat /sdcard/MTK_AI_Engine/eem_offsets/normal/$k.txt 2>/dev/null)
  [ -n "$v" ] && echo "$v" > "$p" 2>/dev/null && log_msg "[✓] $k: ${v}mV"
done || true

#Thermal Restored
find /sys -path '*/thermal/thermal_zone*/mode' -exec sh -c 'echo enabled > "$1" 2>/dev/null || true' _ {} \;
cmd thermalservice reset 2>/dev/null

#CPUFREQ POWER MODE
if [ -f "$SDCARD/cpufreq_mode" ]; then
echo "0" > /proc/cpufreq/cpufreq_power_mode || true
echo "0" > /proc/cpufreq/cpufreq_cci_mode || true
fi

# Powersaver
settings put global low_power 1
battery_saver

#Powermode
setprop 'persist.sys.power_mode_perf' '0' || true
setprop 'persist.sys.perf_boost_enabled' '0' || true
setprop 'persist.sys.perf_mode' '0' || true
setprop 'persist.sys.performance' '0' || true
setprop 'persist.sys.performance_mode' '0' || true
setprop 'sys.hwc.gpu_perf_mode' '0' || true
setprop 'vendor.perf.framepacing.enable' '0' || true
setprop 'vendor.performance.gbe' '0' || true
settings put global 'sustained_performance_mode_enabled' '0'
settings put system persist.sys.power_mode_perf 0 2>/dev/null || true
cmd power set-mode 1
cmd power set-adaptive-power-saver-enabled true
su -c "cmd power set-fixed-performance-mode-enabled false" || true
su -c "settings put global power_manager_constants fixed_performance_mode=false" || true

# Powersaving in normal use
setprop persist.sys.batterysaver true || true
setprop persist.sys.doze_mode true || true

# Zygote & background apps optimization 
setprop 'dalvik.vm.usap_pool_enabled' 'true' || true
settings put global app_standby_enabled 1 || true
settings put global background_dex_opt_job true || true

# Restore Disable HW & 4XMSAA
setprop debug.egl.force_msaa false || true
service call SurfaceFlinger 1008 i32 0 >/dev/null 2>&1 || true

# --- Helper Functions ---
apply() {
[ ! -f "$2" ] && return 1
chmod 644 "$2" >/dev/null 2>&1
echo "$1" >"$2" 2>/dev/null
chmod 444 "$2" >/dev/null 2>&1
}

write() {
[ ! -f "$2" ] && return 1
chmod 644 "$2" >/dev/null 2>&1
echo "$1" >"$2" 2>/dev/null
}

cpufreq_ppm_max_perf() {
cluster=-1
for path in /sys/devices/system/cpu/cpufreq/policy*; do
((cluster++))
cpu_maxfreq=$(<"$path/cpuinfo_max_freq")
write "$cluster $cpu_maxfreq" /proc/ppm/policy/hard_userlimit_max_cpu_freq
write "$cluster $cpu_maxfreq" /proc/ppm/policy/hard_userlimit_min_cpu_freq
done
}

cpufreq_max_perf() {
for path in /sys/devices/system/cpu/*/cpufreq; do
cpu_maxfreq=$(<"$path/cpuinfo_max_freq")
apply "$cpu_maxfreq" "$path/scaling_max_freq"
apply "$cpu_maxfreq" "$path/scaling_min_freq"
done
chmod -f 444 /sys/devices/system/cpu/cpufreq/policy*/scaling_*_freq 2>/dev/null
}

# --- Common System Tweaks ---
apply 0 /proc/sys/kernel/panic
apply 0 /proc/sys/kernel/panic_on_oops
apply 0 /proc/sys/kernel/panic_on_warn
apply 0 /proc/sys/kernel/softlockup_panic
sync

find /sys/block -maxdepth 1 -mindepth 1 -exec sh -c 'for d; do echo 0 > $d/queue/iostats; echo 0 > $d/queue/add_random; done' _ {} + &

for algo in bbr3 bbr2 bbrplus bbr westwood cubic; do
if grep -q "$algo" /proc/sys/net/ipv4/tcp_available_congestion_control 2>/dev/null; then
apply "$algo" /proc/sys/net/ipv4/tcp_congestion_control
break
fi
done

apply 1 /proc/sys/net/ipv4/tcp_low_latency
apply 1 /proc/sys/net/ipv4/tcp_ecn
apply 3 /proc/sys/net/ipv4/tcp_fastopen
apply 1 /proc/sys/net/ipv4/tcp_sack
apply 0 /proc/sys/net/ipv4/tcp_timestamps
apply 3 /proc/sys/kernel/perf_cpu_time_max_percent
apply 0 /proc/sys/kernel/sched_schedstats
apply 0 /proc/sys/kernel/task_cpustats_enable
apply 0 /proc/sys/kernel/sched_autogroup_enabled
apply 1 /proc/sys/kernel/sched_child_runs_first
apply 32 /proc/sys/kernel/sched_nr_migrate
apply 50000 /proc/sys/kernel/sched_migration_cost_ns
apply 1000000 /proc/sys/kernel/sched_min_granularity_ns
apply 1500000 /proc/sys/kernel/sched_wakeup_granularity_ns
apply 0 /proc/sys/vm/page-cluster
apply 15 /proc/sys/vm/stat_interval
apply 0 /proc/sys/vm/compaction_proactiveness
apply 0 /sys/module/mmc_core/parameters/use_spi_crc
apply 0 /sys/module/opchain/parameters/chain_on
apply 0 /sys/module/cpufreq_bouncing/parameters/enable
apply 0 /proc/task_info/task_sched_info/task_sched_info_enable
apply 0 /proc/oplus_scheduler/sched_assist/sched_assist_enabled
apply "libunity.so, libil2cpp.so, libmain.so, libUE4.so, libgodot_android.so, libgdx.so, libgdx-box2d.so, libminecraftpe.so, libLive2DCubismCore.so, libyuzu-android.so, libryujinx.so, libcitra-android.so, libhdr_pro_engine.so, libandroidx.graphics.path.so, libeffect.so" /proc/sys/kernel/sched_lib_name
apply 255 /proc/sys/kernel/sched_lib_mask_force

find /sys/class/thermal -maxdepth 1 -name "thermal_zone*" -exec sh -c 'for d; do echo step_wise > $d/policy; done' _ {} +

# --- Performance Profile ---
[ -f /sys/module/battery_saver/parameters/enabled ] && {
if grep -qo '[0-9]\+' /sys/module/battery_saver/parameters/enabled; then
apply 0 /sys/module/battery_saver/parameters/enabled
else
apply N /sys/module/battery_saver/parameters/enabled
fi
}

apply 0 /proc/sys/kernel/split_lock_mitigate

if [ -f "/sys/kernel/debug/sched_features" ]; then
apply NEXT_BUDDY /sys/kernel/debug/sched_features
apply NO_TTWU_QUEUE /sys/kernel/debug/sched_features
fi

if [ -d "/dev/stune/" ]; then
apply 1 /dev/stune/top-app/schedtune.prefer_idle
apply 1 /dev/stune/top-app/schedtune.boost
fi

tp_path="/proc/touchpanel"
if [ -d "$tp_path" ]; then
apply 1 $tp_path/game_switch_enable
apply 0 $tp_path/oplus_tp_limit_enable
apply 0 $tp_path/oppo_tp_limit_enable
apply 1 $tp_path/oplus_tp_direction
apply 1 $tp_path/oppo_tp_direction
fi

apply 80 /proc/sys/vm/vfs_cache_pressure

# Force CPU to highest possible frequency (Frequency locking, not governor)
if [ -d /proc/ppm ]; then
cpufreq_ppm_max_perf
else
cpufreq_max_perf
fi

echo 3 >/proc/sys/vm/drop_caches
wait
sh "/data/adb/modules/MTK_AI/MTK_AI/AI_MODE/normal_mode/bypass_off" || true
touch /dev/.mtk_ai_normal_mode
exit 0
