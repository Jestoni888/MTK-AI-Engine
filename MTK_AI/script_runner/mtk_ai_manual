#!/system/bin/sh

pkill -x powersave
SCRIPT_PATH="/data/adb/modules/MTK_AI/script_runner/mtk_ai_manual"

for pid in $(pgrep -f "$SCRIPT_PATH"); do
    # Kill all instances except the current running script ($$)
    if [ "$pid" != "$$" ]; then
        kill -9 "$pid" 2>/dev/null
    fi
done

CONFIG_DIR="/sdcard/MTK_AI_Engine"
CONFIG_FILE="$CONFIG_DIR/devfreq_config.conf"
LOG_FILE="$CONFIG_DIR/MTK_AI_Engine.log"
PPM_CONFIG="$CONFIG_DIR/ppm_config.conf"
PPM_PATH="/proc/ppm/policy_status"
CPULIMIT="/data/adb/modules/MTK_AI/lib/cpulimit"

### === SINGLE INSTANCE LOCK ===
LOCK_DIR="/data/adb/modules/MTK_AI/.guard"
mkdir -p "$LOCK_DIR" 2>/dev/null || true
LOCK_FILE="$LOCK_DIR/mtk_ai_manual.pid"

# Helper: safe logging (works on all Android versions)
log_msg() { log -t MTK_AI "$@" 2>/dev/null || echo "[MTK_AI] $*"; }

echo "=== MTK AI MANUAL OVERRIDES STARTING ==="
settings put global low_power 0 >/dev/null 2>&1 || true
settings put global low_power_sticky 0 >/dev/null 2>&1 || true
echo "0" > /proc/sys/kernel/panic 2>/dev/null || true

# CPU GOVERNOR ---
GOV_CONFIG="$CONFIG_DIR/manual_governor.txt"
GOVERNOR="schedutil" # Set default fallback

cpu_governor() {
# 1. Determine which governor to use
if [ -f "$GOV_CONFIG" ]; then
    GOVERNOR=$(cat "$GOV_CONFIG" 2>/dev/null | tr -d '\r\n\t ') || true
    if [ -z "$GOVERNOR" ]; then
        echo "Empty governor config, falling back to default: schedutil"
        GOVERNOR="schedutil"
    else
        echo "Applying governor from config: $GOVERNOR"
    fi
else
    echo "No governor config found, falling back to default: schedutil"
fi

# 2. Apply the selected governor to ALL CPUs
for cpu in /sys/devices/system/cpu/cpu[0-9]*; do
    if [ -f "$cpu/cpufreq/scaling_available_governors" ]; then
        if grep -q "$GOVERNOR" "$cpu/cpufreq/scaling_available_governors" 2>/dev/null; then
            
            # Note: If you run this script as root, you don't need 'su' or 'chmod 777'.
            # If you must use su, ensure it's configured for passwordless root access.
            su -c "chmod 644 '$cpu/cpufreq/scaling_governor'" >/dev/null 2>&1 || true
            
            if su -c "echo '$GOVERNOR' > '$cpu/cpufreq/scaling_governor'" 2>/dev/null; then
                echo "✓ Governor applied to $cpu"
            else
                echo "✗ Failed to apply governor to $cpu (skipping)"
            fi
        else
            echo "Governor '$GOVERNOR' not available for $cpu (skipping)"
        fi
    fi
done
}
cpu_governor

# --- 1. RESOLUTION SCALING ---
RES_CONFIG="$CONFIG_DIR/resolution_scale_config.txt"
if [ -f "$RES_CONFIG" ]; then
    SCALE=$(grep -m1 "^scale=" "$RES_CONFIG" 2>/dev/null | cut -d'=' -f2 | tr -d '\r\n\t ') || true
    TEXTURE=$(grep -m1 "^texture=" "$RES_CONFIG" 2>/dev/null | cut -d'=' -f2 | tr -d '\r\n\t ') || true
    TARGET_DENSITY=$(grep -m1 "^density=" "$RES_CONFIG" 2>/dev/null | cut -d'=' -f2 | tr -d '\r\n\t ') || true

    if [ -n "$TARGET_DENSITY" ] && [ "$TARGET_DENSITY" -gt 0 ] 2>/dev/null; then
        echo "Applying resolution config: scale=${SCALE}%, texture=${TEXTURE}, density=${TARGET_DENSITY}"
        
        if su -c "wm density $TARGET_DENSITY" >/dev/null 2>&1; then
            echo "✓ Resolution/Density applied successfully"
            log_msg "Resolution config applied: scale=$SCALE, texture=$TEXTURE, density=$TARGET_DENSITY"
        else
            echo "✗ Failed to apply density $TARGET_DENSITY (skipping)"
            log_msg "Failed to apply density: $TARGET_DENSITY"
        fi
    else
        echo "Invalid or missing density value in config (skipping)"
        log_msg "Invalid density value in resolution_scale_config.txt"
    fi
else
    echo "No resolution config found at $RES_CONFIG (skipping)"
fi

# --- 3. RENDERER ---
RENDERER_CONFIG="$CONFIG_DIR/manual_renderer.txt"
RENDERER=""

# 1. Try to read from the config file if it exists
if [ -f "$RENDERER_CONFIG" ]; then
    RENDERER=$(cat "$RENDERER_CONFIG" 2>/dev/null | tr -d '\r\n\t ') || true
fi

# 2. Apply the renderer or reset to default
if [ -n "$RENDERER" ]; then
    # If a valid config was found, apply it
    echo "Applying custom renderer: $RENDERER"
    if su -c "setprop debug.hwui.renderer '$RENDERER'" 2>/dev/null; then
        echo "✓ Custom renderer applied"
    else
        echo "✗ Failed to apply renderer"
    fi
else
    # Fallback: Clear the property so Android uses its native default (skiagl)
    echo "No renderer config found. Resetting to system default."
    su -c "setprop debug.hwui.renderer ''" 2>/dev/null || true
    echo "✓ Renderer reset to default"
fi

# --- 4. REFRESH RATE ---
REFRESH_CONFIG="$CONFIG_DIR/manual_refresh_lock.txt"
MODE_ID=""

# 1. Read config if it exists
if [ -f "$REFRESH_CONFIG" ]; then
    MODE_ID=$(cat "$REFRESH_CONFIG" 2>/dev/null | tr -d '\r\n\t ') || true
fi

# 2. Fallback to -1 if no config found or if the file is empty
if [ -z "$MODE_ID" ]; then
    MODE_ID="-1"
    echo "No refresh rate config found or empty, falling back to default mode: -1"
fi

# 3. Apply the refresh rate
echo "Applying refresh rate mode: $MODE_ID"
if su -c "service call SurfaceFlinger 1035 i32 $MODE_ID" 2>/dev/null; then
    echo "✓ Refresh rate applied"
else
    echo "✗ Failed to apply refresh rate"
fi

# --- 8. SURFACEFLINGER CPU LIMIT ---
pkill -f cpulimit >/dev/null 2>&1 || true

if [ -f "/sdcard/MTK_AI_Engine/limit_surfaceflinger" ]; then
    SF_PID=$(pidof surfaceflinger 2>/dev/null || true)
    if [ -n "$SF_PID" ]; then
        echo "Limiting SurfaceFlinger PID: $SF_PID"
        nohup "$CPULIMIT" -p "$SF_PID" -l 80 -z >/dev/null 2>&1 &
    else
        echo "⚠️ SurfaceFlinger PID not found (skipping limit)"
    fi
fi

echo "✅ Devfreq settings loaded successfully!"
echo "=== MTK AI MANUAL OVERRIDES COMPLETED ==="

exit 0
