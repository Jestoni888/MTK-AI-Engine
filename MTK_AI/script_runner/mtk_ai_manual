#!/system/bin/sh
pkill -x powersave 2>/dev/null
S="/data/adb/modules/MTK_AI/script_runner/mtk_ai_manual"
for p in $(pgrep -f "$S"); do [ "$p" != "$$" ] && kill -9 "$p" 2>/dev/null; done
C="/sdcard/MTK_AI_Engine"; M="/data/adb/modules/MTK_AI"
mkdir -p "$M/.guard" 2>/dev/null
log() { log -t MTK_AI "$@" 2>/dev/null || echo "[MTK_AI] $*"; }
settings put global low_power 0 >/dev/null 2>&1; settings put global low_power_sticky 0 >/dev/null 2>&1
echo 0 > /proc/sys/kernel/panic 2>/dev/null

# CPU Governor
G=$(tr -d '\r\n\t ' < "$C/manual_governor.txt" 2>/dev/null); G=${G:-schedutil}
for c in /sys/devices/system/cpu/cpu[0-9]*; do
  [ -f "$c/cpufreq/scaling_available_governors" ] && grep -q "$G" "$c/cpufreq/scaling_available_governors" 2>/dev/null && \
  su -c "chmod 644 '$c/cpufreq/scaling_governor' && echo '$G' > '$c/cpufreq/scaling_governor'" 2>/dev/null
done

# Resolution
D=$(grep -m1 "^density=" "$C/resolution_scale_config.txt" 2>/dev/null | cut -d= -f2 | tr -d '\r\n\t ')
[ "$D" -gt 0 ] 2>/dev/null && su -c "wm density $D" >/dev/null 2>&1 && log "Density: $D"

# Renderer
R=$(tr -d '\r\n\t ' < "$C/manual_renderer.txt" 2>/dev/null); su -c "setprop debug.hwui.renderer '${R:-}'" 2>/dev/null

# Refresh Rate
F=$(tr -d '\r\n\t ' < "$C/manual_refresh_lock.txt" 2>/dev/null); F=${F:--1}
su -c "service call SurfaceFlinger 1035 i32 $F" 2>/dev/null

# SurfaceFlinger CPU Limit
pkill -f cpulimit 2>/dev/null
if [ -f "$C/limit_surfaceflinger" ]; then
  P=$(pidof surfaceflinger 2>/dev/null)
  [ -n "$P" ] && nohup "$M/lib/cpulimit" -p "$P" -l 80 -z >/dev/null 2>&1 &
fi
M="/data/adb/modules/MTK_AI"; E="/sdcard/MTK_AI_Engine"
[ -f "$E/enable_fastcharge" ] && export LD_LIBRARY_PATH="$M/lib64:$LD_LIBRARY_PATH" && nohup "$M/MTK_AI/AI_MODE/global_mode/heartbeat" >/dev/null 2>&1 &
nohup sh "$M/script_runner/boost_color_apply.sh" >/dev/null 2>&1 &
nohup "$M/MTK_AI/AI_MODE/normal_mode/powersavex" >/dev/null 2>&1 &
if [ -f "$E/fast_reboot_enabled" ]; then
    log -t MTK_AI "Fast reboot enabled" 2>/dev/null || echo "[MTK_AI] Fast reboot enabled"
    setprop debug.sf.nobootanimation 1; setprop persist.sys.mtk.fast_boot 1 2>/dev/null
    setprop ro.config.fastboot 1 2>/dev/null; setprop ro.zygote.disable_gl_preload 1 2>/dev/null
    setprop pm.dexopt.bg-dexopt verify
fi
[ -f "$E/freeze/$pkg" ] && pm suspend "$pkg" 2>/dev/null
devfreq() {
    B="$E"
    if [ -f "$B/devfreq_config.json" ]; then
        GOV=$(grep -o '"governor": *"[^"]*"' "$B/devfreq_config.json"|cut -d'"' -f4)
        LK=$(grep -o '"isLocked": *[a-z]*' "$B/devfreq_config.json"|awk '{print $2}')
        MN=$(grep -o '"minFreq": *[0-9]*' "$B/devfreq_config.json"|awk '{print $2}')
        MX=$(grep -o '"maxFreq": *[0-9]*' "$B/devfreq_config.json"|awk '{print $2}')
        find /sys -type f -name "available_frequencies" 2>/dev/null|while read -r f; do
            d="${f%/*}"; case "$d" in *mem*|*dvfs*|*dmc*|*gpu*|*gpubw*) ;; *) continue;; esac
            [ -r "$f" ] || continue; [ -n "$GOV" ] && echo "$GOV" > "$d/governor" 2>/dev/null
            if [ "$LK" = "true" ]; then
                [ -n "$MX" ] && echo "$((MX*1000))" > "$d/max_freq" 2>/dev/null
                [ -n "$MN" ] && echo "$((MN*1000))" > "$d/min_freq" 2>/dev/null
            else awk '{print $1}' "$f" > "$d/min_freq" 2>/dev/null; awk '{print $NF}' "$f" > "$d/max_freq" 2>/dev/null; fi
            break
        done
    fi
    if [ -f "$B/devfreq_other_config.json" ]; then
        awk '/": \{/{gsub(/"/,"",$1);gsub(/:$/,"",$1);n=$1}/"minFreq"/{m=$2+0}/"maxFreq"/{x=$2+0;print n,m,x}' "$B/devfreq_other_config.json"|while read -r n m x; do
            [ -z "$n" ]||[ -z "$m" ]||[ -z "$x" ]&&continue
            find /sys -type f -name "available_frequencies" 2>/dev/null|while read -r f; do
                d="${f%/*}"; [ "${d##*/}" = "$n" ]||continue; [ -r "$f" ]||continue
                if [ -w "$d/min_freq" ]&&[ -w "$d/max_freq" ]; then
                    echo "$((x*1000))" > "$d/max_freq" 2>/dev/null; echo "$((m*1000))" > "$d/min_freq" 2>/dev/null
                elif [ -w "$d/set_freq" ]; then echo "$((x*1000))" > "$d/set_freq" 2>/dev/null; fi
                break
            done
        done
    fi
}
devfreq
for f in "enabled true" "vibration_disabled true" "animation_disabled true" "launch_boost_disabled true" "aod_disabled true" "datasaver true" "force_all_apps_standby true" "quick_doze_enabled true" "soundtrigger_disabled true" "optional_sensors_disabled true" "gps_mode 3" "adjust_brightness_factor 0.5"; do device_config put battery_saver $f; done
M=/data/adb/modules/MTK_AI/MTK_AI/AI_MODE
[ -f /dev/.mtk_ai_active_game ] && $M/gaming_mode/app_optimizer || $M/normal_mode/normal_prop