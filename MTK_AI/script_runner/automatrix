#!/system/bin/sh

SCRIPT_PATH="/data/adb/modules/MTK_AI/script_runner/automatrix"

for pid in $(pgrep -f "$SCRIPT_PATH"); do
    # Kill all instances except the current running script ($$)
    if [ "$pid" != "$$" ]; then
        kill -9 "$pid" 2>/dev/null
    fi
done
# ==========================================
log_msg() { log -t MTK_AI "$@" 2>/dev/null || echo "[MTK_AI] $*"; }

MOD_DIR="/data/adb/modules/MTK_AI"
EXTERNAL_CFG="/sdcard/MTK_AI_Engine"

if [ -f "$EXTERNAL_CFG/enable_fastcharge" ]; then
    export LD_LIBRARY_PATH="/data/adb/modules/MTK_AI/lib64:$LD_LIBRARY_PATH"
    nohup "$MOD_DIR/MTK_AI/AI_MODE/global_mode/heartbeat" >/dev/null 2>&1 &
fi
nohup sh "$MOD_DIR/script_runner/boost_color_apply.sh" >/dev/null 2>&1 &
nohup sh "$MOD_DIR/update_checker.sh" >/dev/null 2>&1 &
nohup "$MOD_DIR/MTK_AI/AI_MODE/normal_mode/powersavex" >/dev/null 2>&1 &

FAST_REBOOT_FLAG="$EXTERNAL_CFG/fast_reboot_enabled"

if [ -f "$FAST_REBOOT_FLAG" ]; then
    log_msg "Fast reboot enabled, applying safe optimizations"
    setprop debug.sf.nobootanimation 1
    setprop persist.sys.mtk.fast_boot 1 2>/dev/null
    setprop ro.config.fastboot 1 2>/dev/null
    setprop ro.zygote.disable_gl_preload 1 2>/dev/null
    setprop pm.dexopt.bg-dexopt verify
    log_msg "Fast reboot mode active (dex2oat-safe)"
else
    log_msg "Fast reboot flag not found, skipping"
fi

if [ -f "/sdcard/MTK_AI_Engine/freeze/$pkg" ]; then
    pm suspend "$pkg" 2>/dev/null
fi

devfreq_nodes() {
    B="/sdcard/MTK_AI_Engine"

    # 1. Main Devfreq Node (Governor + Freq)
    if [ -f "$B/devfreq_config.json" ]; then
        GOV=$(grep -o '"governor": *"[^"]*"' "$B/devfreq_config.json" | cut -d'"' -f4)
        LK=$(grep -o '"isLocked": *[a-z]*' "$B/devfreq_config.json" | awk '{print $2}')
        MN=$(grep -o '"minFreq": *[0-9]*' "$B/devfreq_config.json" | awk '{print $2}')
        MX=$(grep -o '"maxFreq": *[0-9]*' "$B/devfreq_config.json" | awk '{print $2}')

        # find replaces the for loop + case + break
        find /sys -type d -path "*/devfreq/*" \
            \( -name "*mem*" -o -name "*dvfs*" -o -name "*dmc*" -o -name "*gpu*" -o -name "*gpubw*" \) \
            2>/dev/null | head -n 1 | while read -r d; do
            [ -n "$GOV" ] && echo "$GOV" > "$d/governor" 2>/dev/null
            if [ "$LK" = "true" ]; then
                [ -n "$MN" ] && echo "$((MN*1000))" > "$d/min_freq" 2>/dev/null
                [ -n "$MX" ] && echo "$((MX*1000))" > "$d/max_freq" 2>/dev/null
            else
                awk '{print $1}' "$d/available_frequencies" > "$d/min_freq" 2>/dev/null
                awk '{print $NF}' "$d/available_frequencies" > "$d/max_freq" 2>/dev/null
            fi
        done
    fi

    # 2. Other Devfreq Nodes (Freq only)
    if [ -f "$B/devfreq_other_config.json" ]; then
        awk '
            /": \{/ {
                gsub(/"/, "", $1);
                gsub(/:$/, "", $1);
                n=$1
            }
            /"minFreq"/ { m=$2+0 }
            /"maxFreq"/ { x=$2+0; print n, m, x }
        ' "$B/devfreq_other_config.json" | while read -r n m x; do

            [ -z "$n" ] || [ -z "$m" ] || [ -z "$x" ] && continue

            # find replaces the for loop + exact name match + break
            find /sys -type d -path "*/devfreq/*" \
                -name "$n" 2>/dev/null | head -n 1 | while read -r d; do
                echo "$((x*1000))" > "$d/max_freq" 2>/dev/null
                echo "$((m*1000))" > "$d/min_freq" 2>/dev/null
            done
        done
    fi
}

devfreq_nodes

battery_saver() {
for f in "enabled true" "vibration_disabled true" "animation_disabled true" \
  "launch_boost_disabled true" "aod_disabled true" "datasaver true" \
  "force_all_apps_standby true" "quick_doze_enabled true" \
  "soundtrigger_disabled true" "optional_sensors_disabled true" \
  "gps_mode 3" "adjust_brightness_factor 0.5"; do
  device_config put battery_saver $f
done
}

battery_saver
