#!/system/bin/sh

# --- CONFIGURATION ---
TEMP_FILE="/sys/class/power_supply/battery/temp"
VOLT_FILE="/sys/class/power_supply/battery/voltage_now"
CURR_FILE="/sys/class/power_supply/battery/current_now"
STATS_DIR="/sdcard/MTK_AI_Engine"
CONFIG_DIR="/sdcard/MTK_AI_Engine"
TRIGGER_FILE="/dev/.mtk_ai_active_game"

# Fallback paths
[ ! -f "$VOLT_FILE" ] && VOLT_FILE="/sys/class/power_supply/bms/voltage_now"
[ ! -f "$CURR_FILE" ] && CURR_FILE="/sys/class/power_supply/bms/current_now"

mkdir -p "$STATS_DIR" 2>/dev/null
mkdir -p "$CONFIG_DIR" 2>/dev/null

# State files for FPS tracking (10-cycle countdown)
FPS_PEAK_FILE="$STATS_DIR/.fps_peak"
FPS_SUM_FILE="$STATS_DIR/.fps_sum"
FPS_COUNT_FILE="$STATS_DIR/.fps_count"
PKG_FILE="$STATS_DIR/.current_pkg"

# ==========================================
# 🔍 GET CURRENT FOCUSED PACKAGE
# ==========================================
get_current_pkg() {
    DUMP=$(dumpsys activity activities 2>/dev/null)
CURRENT_TOP_APP=$(echo "$DUMP" | grep -m1 -E 'mResumedActivity|mFocusedApp' | grep -oE '[a-zA-Z0-9_]+(\.[a-zA-Z0-9_]+)+' | head -n 1)
    echo "$CURRENT_TOP_APP" | tr -d '[:space:]'
}

# ==========================================
# 🚀 GET REAL FPS FROM LOGCAT
# ==========================================
get_real_fps() {
    local pkg="$1"
    local fps=0
    fps=$(logcat -b main -d 2>/dev/null | \
        grep "BufferQueueProducer.*$pkg.*fps=" | \
        tail -5 | \
        awk -F'fps=' '{
            split($2,a," ")
            fps=a[1]+0
            if(fps > 0 && fps > max) max = fps
        }
        END { if(max > 0) printf "%.0f", max; else print "0" }')
    [ -z "$fps" ] && fps=0
    echo "$fps"
}

# ==========================================
# 🌡️ GET TEMPERATURE
# ==========================================
get_temp() {
    local raw_temp=$(cat "$TEMP_FILE" 2>/dev/null || echo "0")
    # Convert to Celsius (assuming raw is in tenths of a degree)
    echo "$((raw_temp / 10))"
}

# ==========================================
# 🎯 MAIN ONESHOT LOGIC
# ==========================================

# Ensure state files exist
[ ! -f "$FPS_PEAK_FILE" ] && echo "0" > "$FPS_PEAK_FILE"
[ ! -f "$FPS_SUM_FILE" ] && echo "0" > "$FPS_SUM_FILE"
[ ! -f "$FPS_COUNT_FILE" ] && echo "0" > "$FPS_COUNT_FILE"
[ ! -f "$PKG_FILE" ] && echo "" > "$PKG_FILE"

CURRENT_PKG=$(get_current_pkg)
TEMP_VAL=$(get_temp)
LAST_PKG=$(cat "$PKG_FILE" 2>/dev/null)

# Reset FPS tracking if the active package changes (prevents false triggers)
if [ "$CURRENT_PKG" != "$LAST_PKG" ]; then
    echo "$CURRENT_PKG" > "$PKG_FILE"
    echo "0" > "$FPS_PEAK_FILE"
    echo "0" > "$FPS_SUM_FILE"
    echo "0" > "$FPS_COUNT_FILE"
fi

if [ -f "$TRIGGER_FILE" ]; then
    # ==========================================
    # 🎮 GAMING MODE
    # ==========================================
    
    # 1. Temperature Check
    if [ "$TEMP_VAL" -ge 44 ]; then
        echo "1" >/dev/null 2>&1 || true
    fi

    # 2. FPS Check (if we have a valid package)
    if [ -n "$CURRENT_PKG" ]; then
        ACTUAL_FPS=$(get_real_fps "$CURRENT_PKG")
        
        # Read state
        PEAK=$(cat "$FPS_PEAK_FILE" 2>/dev/null || echo "0")
        SUM=$(cat "$FPS_SUM_FILE" 2>/dev/null || echo "0")
        COUNT=$(cat "$FPS_COUNT_FILE" 2>/dev/null || echo "0")
        
        # Update peak
        if [ "$ACTUAL_FPS" -gt "$PEAK" ]; then
            PEAK=$ACTUAL_FPS
            echo "$PEAK" > "$FPS_PEAK_FILE"
        fi
        
        # Accumulate
        SUM=$((SUM + ACTUAL_FPS))
        COUNT=$((COUNT + 1))
        
        # Check 10-cycle countdown
        if [ "$COUNT" -ge 10 ]; then
            AVG=$((SUM / COUNT))
            # Check if average drops 20% from peak (i.e., avg < peak * 0.8)
            # To avoid floating point math in sh, we do: avg * 10 < peak * 8
            THRESHOLD=$((PEAK * 8 / 10))
            
            if [ "$PEAK" -gt 0 ] && [ "$AVG" -lt "$THRESHOLD" ]; then
                # Launch AI/Gaming scripts
                nohup sh /data/adb/modules/MTK_AI/MTK_AI/AI_MODE/gaming_mode/gaming_prop >/dev/null 2>&1 || true
                nohup sh /data/adb/modules/MTK_AI/MTK_AI/AI_MODE/gaming_mode/gaming_prop_2 >/dev/null 2>&1 || true
                nohup sh /data/adb/modules/MTK_AI/MTK_AI/AI_MODE/gaming_mode/performance >/dev/null 2>&1 || true
                nohup sh /data/adb/modules/MTK_AI/MTK_AI/AI_MODE/gaming_mode/disable_thermal >/dev/null 2>&1 || true
                nohup sh "/data/adb/modules/MTK_AI/MTK_AI/AI_MODE/global_mode/ram_cleaner" >/dev/null 2>&1 &
            fi
            
            # Reset cycle for next countdown
            echo "0" > "$FPS_SUM_FILE"
            echo "0" > "$FPS_COUNT_FILE"
            # Reset peak to current FPS to start a fresh window
            echo "$ACTUAL_FPS" > "$FPS_PEAK_FILE"
        else
            echo "$SUM" > "$FPS_SUM_FILE"
            echo "$COUNT" > "$FPS_COUNT_FILE"
        fi
    fi

else
    # ==========================================
    # 📱 NORMAL MODE
    # ==========================================
    
    if [ "$TEMP_VAL" -ge 42 ]; then
        echo "powersave" > "$STATS_DIR/current_profile"
        echo "1" > "$STATS_DIR/enable_limiter"
    elif [ "$TEMP_VAL" -le 36 ]; then
        echo "balance" > "$STATS_DIR/current_profile"
        rm -f "$STATS_DIR/enable_limiter"
    fi
    
    # Reset gaming FPS state if switching to normal mode
    echo "0" > "$FPS_PEAK_FILE"
    echo "0" > "$FPS_SUM_FILE"
    echo "0" > "$FPS_COUNT_FILE"
fi
